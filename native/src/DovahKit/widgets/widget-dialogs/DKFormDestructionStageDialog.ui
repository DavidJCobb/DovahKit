     <widget class="QCheckBox" name="flagCapDamage">
      <property name="geometry">
       <rect>
        <x>11</x>
        <y>24</y>
        <width>84</width>
        <height>17</height>
       </rect>
      </property>
      <property name="whatsThis">
       <string>Prevents skipping through destruction stages. That is: If this setting is enabled and the object, while in this destruction stage, takes enough damage to progress through multiple destruction stages, it will instead progress only to the next stage.</string>
      </property>
      <property name="text">
       <string>Cap Damage</string>
      </property>
