     <widget class="QCheckBox" name="flagIgnoreExternal">
      <property name="geometry">
       <rect>
        <x>11</x>
        <y>93</y>
        <width>124</width>
        <height>17</height>
       </rect>
      </property>
      <property name="whatsThis">
       <string>If enabled, the object cannot take damage from outside sources during this destruction stage; it will only take whatever self-damage it deals per second.</string>
      </property>
      <property name="text">
       <string>Ignore External Dmg.</string>
      </property>
