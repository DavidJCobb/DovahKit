<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
   <Type Name="dovahkit::subsystems::worldinput::inputs::button">

      <Intrinsic Name="_is_key" Expression="key.vk != cobb::keyboard::virtual_key::none || key.unicode || key.scan_code" />

      <DisplayString IncludeView="stringified" Condition="_is_key()">{key,view(keyname)}</DisplayString>
      <DisplayString IncludeView="stringified" Condition="mouse != Qt::MouseButton::NoButton">{mouse,en}</DisplayString>
      <DisplayString IncludeView="stringified" Condition="gamepad != dovahkit::subsystems::xinput::button::none">{gamepad,en}</DisplayString>

      <DisplayString Condition="_is_key()">key: {key}</DisplayString>
      <DisplayString Condition="mouse != Qt::MouseButton::NoButton">mouse: {mouse,en}</DisplayString>
      <DisplayString Condition="gamepad != dovahkit::subsystems::xinput::button::none">gamepad: {gamepad,en}</DisplayString>
      <DisplayString>&lt;none&gt;</DisplayString>
   </Type>
</AutoVisualizer>