<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
   <Type Name="dovahkit::subsystems::worldedit::tools::options_union">
      <DisplayString>{*this,!}</DisplayString>
      <Expand>
         <Item Name="tag">tag</Item>
         <Synthetic Name="[data]" Condition="tag == (tool_id)-1">
            <DisplayString>&lt;empty&gt;</DisplayString>
         </Synthetic>
         <Item Optional="true"
            Name="[data: attempt_on_screen_selection]"
         >
            (attempt_on_screen_selection::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: debug_dump_landscape_details]"
         >
            *(debug_dump_landscape_details::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: debug_dump_raycast]"
         >
            *(debug_dump_raycast::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: debug_print]"
         >
            *(debug_print::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: modify_camera_speed_flags]"
         >
            *(modify_camera_speed_flags::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: move_camera]"
         >
            *(move_camera::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: move_selection]"
         >
            *(move_selection::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: set_edit_gizmo_mode]"
         >
            *(set_edit_gizmo_mode::options*)&amp;data[0]
         </Item>
         <Item Optional="true"
            Name="[data: turn_camera]"
         >
            *(turn_camera::options*)&amp;data[0]
         </Item>
         <Item Name="[raw bytes]">data</Item>
      </Expand>
   </Type>
</AutoVisualizer>