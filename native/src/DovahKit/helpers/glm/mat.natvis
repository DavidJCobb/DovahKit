<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
   <Type Name="glm::mat&lt;*,*,*,*&gt;">

      <Intrinsic Name="_sign_of" Expression="(0 &lt; n) - (n &lt; 0)">
         <Parameter Name="n" Type="int" />
      </Intrinsic>

      <Intrinsic Name="_fabs" Expression="(n &lt; 0) ? -n : n">
         <Parameter Name="n" Type="double" />
      </Intrinsic>
      
      <DisplayString>{{ size={$T1,d}x{$T2,d} (column-major: cols x rows) }}</DisplayString>
      <Expand>
         <Synthetic Name="[matrix info]">
            <DisplayString>Matrix is column-major; displayed indices are [X][Y].</DisplayString>
         </Synthetic>
         <Synthetic Name="[transform]" Condition="$T1 &gt;= 3 &amp;&amp; $T2 &gt;= 3">
            <DisplayString Condition="$T2 == 3">&lt;rotation and scale&gt;</DisplayString>
            <DisplayString>&lt;position, rotation, and scale&gt;</DisplayString>
            <Expand>
               <Synthetic Name="[position]" Condition="$T2 &gt; 3">
                  <Expand>
                     <Item Name="[x]">value[3].x</Item>
                     <Item Name="[y]">value[3].y</Item>
                     <Item Name="[z]">value[3].z</Item>
                  </Expand>
               </Synthetic>
               <Synthetic Name="[rotation]">
                  <DisplayString>&lt;euler XYZ lefthanded&gt;</DisplayString>
                  <Expand>
                     <CustomListItems>
                        <Variable Name="TAYLOR_ITERATIONS" InitialValue="10"/>
                        <Variable Name="EPSILON" InitialValue="0.0005"/>
                        <Variable Name="RAD_TO_DEG_MULT" InitialValue="57.295779513082320876798154814105170332405472466564"/>
                        
                        <Variable Name="angle"   InitialValue="0"/>
                        <Variable Name="i"       InitialValue="1"/>
                        <Variable Name="n"       InitialValue="1"/>
                        <Variable Name="sign"    InitialValue="-1"/>
                        <Variable Name="numer"   InitialValue="1.0"/>
                        <Variable Name="numer_b" InitialValue="1.0"/>
                        <Variable Name="denom"   InitialValue="1.0"/>
                        <Variable Name="denom_b" InitialValue="1.0"/>
                        <Variable Name="cosY"    InitialValue="1.0"/>
                        
                        <Variable Name="u" InitialValue="0.0"/>
                        <Variable Name="v" InitialValue="0.0"/>

                        <Variable Name="euler_x" InitialValue="0.0"/>
                        <Variable Name="euler_y" InitialValue="0.0"/>
                        <Variable Name="euler_z" InitialValue="0.0"/>
                        
                        <!-- euler_y = asin(-value[2][0]) -->
                        <Exec>angle   = -value[2].x</Exec>
                        <!-- fmod -->
                        <If Condition="angle &gt; 1.0">
                           <Exec>angle -= (uint64_t)angle</Exec>
                        </If>
                        <If Condition="angle &lt; -1.0">
                           <Exec>angle += (uint64_t)_fabs(angle)</Exec>
                        </If>
                        <!-- /fmod -->
                        <Exec>euler_y = angle</Exec>
                        <Exec>numer   = angle</Exec>
                        <Exec>numer_b = 1</Exec>
                        <Exec>denom   = 1</Exec>
                        <Exec>denom_b = 1</Exec>
                        <Exec>i = 1</Exec>
                        <Loop Condition="i &lt; TAYLOR_ITERATIONS">
                           <Exec>n = 2 * (i - 1) + 1</Exec>
                           <Loop Condition="n &lt;= 2 * i">
                              <Exec>numer_b *= n</Exec>
                              <Exec>++n</Exec>
                           </Loop>

                           <Exec>numer *= angle * angle</Exec>

                           <Exec>denom_b *= denom_b</Exec> <!-- == pow(4, i) -->
                           <Exec>denom   *= i</Exec>       <!--  == factorial(i) -->

                           <Exec>euler_y += (numer * numer_b) / (denom_b * (denom * denom) * (2 * i + 1))</Exec>
                           
                           <Exec>++i</Exec>
                        </Loop>
                        <!-- /asin -->

                        <!-- cosY = cos(value[2][0]) -->
                        <Exec>angle = _fabs(value[2].x)</Exec>
                        <Exec>cosY  = 1</Exec>
                        <Exec>numer = 1</Exec>
                        <Exec>denom = 1</Exec>
                        <Exec>i = 1</Exec>
                        <Loop Condition="i &lt; TAYLOR_ITERATIONS">
                           <Exec>numer *= angle * angle</Exec>
                           <!-- factorial -->
                           <Exec>n = 2 * (i - 1) + 1</Exec>
                           <Loop Condition="n &lt;= 2 * i">
                              <Exec>denom *= n</Exec>
                              <Exec>++n</Exec>
                           </Loop>
                           <!-- /factorial -->
                           <Exec>cosY += ((double)sign * numer * denom)</Exec>
                           
                           <Exec>++i</Exec>
                           <Exec>sign = -sign</Exec>
                        </Loop>
                        <!-- /cosine -->
                        
                        <If Condition="_fabs(cosY) &gt; EPSILON">
                           <Exec>u = value[2].z / cosY</Exec>
                           <Exec>v = value[2].y / cosY</Exec>
                           <!-- atan2 -->
                           <If Condition="_fabs(u) &lt; EPSILON">
                              <Exec>euler_x = 1.57079637</Exec>
                              <If Condition="v &lt; 0">
                                 <Exec>euler_x = -1.57079637</Exec>
                              </If>
                           </If>
                           <If Condition="_fabs(u) &gt; EPSILON">
                              <!-- atan -->
                              <Exec>angle = v / u</Exec>
                              <!-- fmod -->
                              <If Condition="angle &gt; 1.0">
                                 <Exec>angle -= (uint64_t)angle</Exec>
                              </If>
                              <If Condition="angle &lt; -1.0">
                                 <Exec>angle += (uint64_t)_fabs(angle)</Exec>
                              </If>
                              <!-- /fmod -->
                              <Exec>euler_x = angle</Exec>
                              <Exec>numer   = angle</Exec>
                              <Exec>sign = -1</Exec>
                              <Exec>i = 1</Exec>
                              <Loop Condition="i &lt; TAYLOR_ITERATIONS">
                                 <Exec>numer   *= angle * angle</Exec>
                                 <Exec>euler_x += numer / (2 * i + 1)</Exec>
                                 <Exec>++i</Exec>
                                 <Exec>sign = -sign</Exec>
                              </Loop>
                              <!-- /atan -->
                              <If Condition="u &lt; 0">
                                 <If Condition="v &gt;= 0">
                                    <Exec>euler_x += 3.14159274</Exec>
                                 </If>
                                 <If Condition="v &lt; 0">
                                    <Exec>euler_x -= 3.14159274</Exec>
                                 </If>
                              </If>
                           </If>
                           <!-- /atan2 -->
                           
                           <Exec>u = value[0].x / cosY</Exec>
                           <Exec>v = value[1].x / cosY</Exec>
                        </If>
                        <If Condition="_fabs(cosY) &lt; EPSILON">
                           <Exec>euler_x = 0</Exec>
                           <Exec>u =  value[1].y</Exec>
                           <Exec>v = -value[0].y</Exec>
                        </If>
                        
                        <!-- atan2 -->
                        <If Condition="_fabs(u) &lt; EPSILON">
                           <Exec>euler_z = 1.57079637</Exec>
                           <If Condition="v &lt; 0">
                              <Exec>euler_z = -1.57079637</Exec>
                           </If>
                        </If>
                        <If Condition="_fabs(u) &gt; EPSILON">
                           <!-- atan -->
                           <Exec>angle = v / u</Exec>
                           <!-- fmod -->
                           <If Condition="angle &gt; 1.0">
                              <Exec>angle -= (uint64_t)angle</Exec>
                           </If>
                           <If Condition="angle &lt; -1.0">
                              <Exec>angle += (uint64_t)_fabs(angle)</Exec>
                           </If>
                           <!-- /fmod -->
                           <Exec>euler_z = angle</Exec>
                           <Exec>numer   = angle</Exec>
                           <Exec>sign = -1</Exec>
                           <Exec>i = 1</Exec>
                           <Loop Condition="i &lt; TAYLOR_ITERATIONS">
                              <Exec>numer   *= angle * angle</Exec>
                              <Exec>euler_z += numer / (2 * i + 1)</Exec>
                              <Exec>++i</Exec>
                              <Exec>sign = -sign</Exec>
                           </Loop>
                           <!-- /atan -->
                           <If Condition="u &lt; 0">
                              <If Condition="v &gt;= 0">
                                 <Exec>euler_z += 3.14159274</Exec>
                              </If>
                              <If Condition="v &lt; 0">
                                 <Exec>euler_z -= 3.14159274</Exec>
                              </If>
                           </If>
                        </If>
                        <!-- /atan2 -->

                        <Item Name="[x-deg]">euler_x * RAD_TO_DEG_MULT,g</Item>
                        <Item Name="[y-deg]">euler_y * RAD_TO_DEG_MULT,g</Item>
                        <Item Name="[z-deg]">euler_z * RAD_TO_DEG_MULT,g</Item>
                     </CustomListItems>
                  </Expand>
               </Synthetic>
               <Synthetic Name="[scale]">
                  <Expand>
                     <CustomListItems>
                        <Variable Name="DBL_EPSILON" InitialValue="2.2204460492503131e-016"/>
                        
                        <Variable Name="axis"    InitialValue="0"/>
                        <Variable Name="squared" InitialValue="(double)0"/>
                        <Variable Name="sq_half" InitialValue="(double)0"/>
                        <Variable Name="n"       InitialValue="(int64_t)0"/>
                        <Variable Name="f"       InitialValue="(double)0"/>
                        <Variable Name="iters"   InitialValue="0"/>
                        <Variable Name="x"       InitialValue="0"/>
                        <Loop Condition="axis &lt; 3">
                           
                           <!-- sqrt is unavailable here, so use the fast inverse square root -->
                           <!--
                              modified double-precision version; see page 10 of
                              "Improving the Accuracy of the Fast Inverse Square Root by Modifying Newton–Raphson Corrections"
                              by Walczyk, Moroz, and Cieslinski
                           -->

                           <Exec>x = 0</Exec>
                           <Exec>squared = 0</Exec>
                           <Loop Condition="x &lt; $T1">
                              <!--
                                 loop needed here because Condition attributes don't prevent parsing;
                                 accessing e.g. value[axis].w breaks this natvis for any matrix type 
                                 with less than four rows, even if Conditions specify that none of 
                                 this should run for those
                              -->
                              <Exec>squared += (&amp;value[axis].x)[x] * (&amp;value[axis].x)[x]</Exec>
                           </Loop>
                           
                           <If Condition="squared != 0">
                              <Exec>sq_half = squared / 2.0</Exec>
                              <Exec>n = *(int64_t*)&amp;squared</Exec>
                              <Exec>n = 0x5FE6ED2102DCBFDA - (n &gt;&gt; 1)</Exec>
                              <Exec>f = *(double*)&amp;n</Exec>
                              <Exec>f = f * (1.5008789551163345 - (sq_half * f * f))</Exec>
                              <Exec>f = f * (1.5000005796762576 - (sq_half * f * f))</Exec>
                              <Exec>f = f * (1.5000000000002520 - (sq_half * f * f))</Exec>
                              <Exec>f = f * (1.5000000000000000 - (sq_half * f * f))</Exec>
                              
                              <!-- from inverse square root (1 / sq) to square root: 1 / (1 / sq) == sq -->
                              <Exec>f = 1 / f</Exec>

                              <!-- inverting the inverse for a normal square root costs precision; round to hide it -->
                              <Exec>f = f * 10000.0</Exec>
                              <Exec>f = (int64_t)(f + ((0.5 - DBL_EPSILON) * _sign_of(f)))</Exec> <!-- round -->
                              <Exec>f = f / 10000.0</Exec>
                           </If>
                           <If Condition="squared == 0">
                              <Exec>f = 0</Exec>
                           </If>
                           
                           <Item Name="[x]" Condition="axis == 0">f,g</Item>
                           <Item Name="[y]" Condition="axis == 1">f,g</Item>
                           <Item Name="[z]" Condition="axis == 2">f,g</Item>
                           <Exec>++axis</Exec>
                        </Loop>
                     </CustomListItems>
                  </Expand>
               </Synthetic>
            </Expand>
         </Synthetic>
         <CustomListItems>
            <Variable Name="x" InitialValue="0"/>
            <Variable Name="y" InitialValue="0"/>
            <Loop Condition="x &lt; $T1">
               <Exec>y = 0</Exec>
               <Loop Condition="y &lt; $T2">
                  <Item Name="[{x,d}][{y,d}]">((const float*)(&amp;value[x]))[y]</Item>
                  <Exec>++y</Exec>
               </Loop>
               <Exec>++x</Exec>
            </Loop>
         </CustomListItems>
      </Expand>
   </Type>
</AutoVisualizer>