<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
   <Type Name="cobb::resizable_grid&lt;*,*&gt;">
      <DisplayString>{{ size={(int)_w,d}x{(int)_h,d}, area={(int)_w*(int)_h,d} }}</DisplayString>
      <Expand>
         <ArrayItems Condition="_length > 0">
            <Direction>Forward</Direction>
            <Rank>_h > 1 ? 2 : 1</Rank>
            <Size>_w</Size>
            <ValuePointer>_data,na</ValuePointer>
         </ArrayItems>
      </Expand>
   </Type>
   <Type Name="cobb::resizable_square_grid&lt;*,*&gt;">
      <DisplayString>{{ size={(int)_length,d}x{(int)_length,d}, area={(int)_length*(int)_length,d} }}</DisplayString>
      <Expand>
         <CustomListItems>
            <Variable Name="half" InitialValue="($T2)(_length / 2)"/>
            <Variable Name="x"    InitialValue="($T2)0"/>
            <Variable Name="y"    InitialValue="($T2)0"/>
            <Loop Condition="x &lt; _length">
               <Exec>y = 0</Exec>
               <Loop Condition="y &lt; _length">
                  <Item Name="({x - half,d}, {y - half,d})">_data[x + (y * _length)]</Item>
                  <Exec>++y</Exec>
               </Loop>
               <Exec>++x</Exec>
            </Loop>
         </CustomListItems>
      </Expand>
   </Type>
</AutoVisualizer>