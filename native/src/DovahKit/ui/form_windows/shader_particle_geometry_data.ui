   <item row="2" column="0">
    <widget class="QGroupBox" name="groupBox_2">
     <property name="whatsThis">
      <string>Each particle in the shader particle geometry will rotate around a pivot point. The center-offset option allows you to offset the pivot point. This can be combined with the rotation settings to make the particles appear to tumble through the air.</string>
     </property>
     <property name="title">
      <string>Center Offset</string>
     </property>
     <layout class="QHBoxLayout" name="horizontalLayout_2" stretch="0,1,0,1">
      <item>
       <widget class="QLabel" name="label_10">
        <property name="text">
         <string>Min:</string>
        </property>
        <property name="buddy">
         <cstring>centerOffsetMin</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QDoubleSpinBox" name="centerOffsetMin">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
      <item>
