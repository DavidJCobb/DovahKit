     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="boxSize">
       <property name="whatsThis">
        <string>&lt;p&gt;A &quot;shader particle geometry&quot; is a 3D cube filled with particles, drawn directly in front of the camera. The particles only exist inside of this cube, and are tiled in all directions to create the illusion of a very large number of particles. The box size option controls the size of the cube.&lt;/p&gt;</string>
       </property>
       <property name="alignment">
        <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
       </property>
      </widget>
     </item>
    </layout>
   </item>
