   <item row="3" column="0">
    <widget class="QGroupBox" name="groupBox_3">
     <property name="whatsThis">
      <string>If the particle texture is an atlas (i.e. a grid of sprites), this defines how many sub-textures the texture is split into (i.e. the dimensions of the grid).</string>
