       </item>
       <item row="2" column="0" colspan="2">
        <widget class="QCheckBox" name="flagCanBeDisarmed">
         <property name="whatsThis">
          <string>If this is checked, then the projectile can be disarmed after it has been placed in the world. In Fallout, this was used for landmines, which were implemented as projectiles (yes, even once they were planted and armed).</string>
         </property>
         <property name="text">
          <string>Can Be Disarmed</string>
         </property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_27">
         <property name="text">
