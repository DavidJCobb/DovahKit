         </property>
         <property name="buddy">
          <cstring>collisionLayer</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="0" colspan="2">
        <widget class="QCheckBox" name="flagHitscan">
         <property name="whatsThis">
          <string>If this is checked, then the projectile hits its targed instantly, without ever being visible on-screen.</string>
         </property>
         <property name="text">
          <string>Hitscan (visible in VATS only)</string>
         </property>
        </widget>
       </item>
       <item row="5" column="0" colspan="2">
        <widget class="QCheckBox" name="flagCritPinsLimbs">
         <property name="whatsThis">
          <string>If this is checked, and a projectile of this type severs a target's limb, the projectile can pin the severed limb to whatever surface it [the projectile] hits afterward.</string>
         </property>
         <property name="text">
          <string>Crit Effect: Pins Limbs</string>
         </property>
        </widget>
       </item>
