         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="DKFormPicker" name="disarmSound">
         <property name="whatsThis">
          <string>Sound to be played when a projectile of this type is disarmed.</string>
         </property>
        </widget>
       </item>
       <item row="6" column="0" colspan="2">
        <widget class="QCheckBox" name="flagPassThroughSmallTransparent">
         <property name="whatsThis">
          <string>If checked, then this projectile can pass through the Small Transparent collision layer, no matter what collision layer the projectile itself is on. In Fallout, this would've been used for things like allowing the player to shoot through chain-link fences.</string>
         </property>
         <property name="text">
          <string>Pass Through Small Transparent</string>
         </property>
        </widget>
       </item>
       <item row="7" column="0" colspan="2">
        <widget class="QCheckBox" name="flagDisableCombatAimCorrection">
         <property name="text">
          <string>Disable Projectile Magnetism to Targets</string>
         </property>
        </widget>
       </item>
       <item row="4" column="0" colspan="2">
        <widget class="QCheckBox" name="flagCanBePickedUp">
         <property name="text">
          <string>Can Be Picked Up</string>
         </property>
        </widget>
       </item>
       <item row="0" column="0">
        <widget class="QLabel" name="label_26">
         <property name="text">
