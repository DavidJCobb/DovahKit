       <item row="2" column="1">
        <widget class="QComboBox" name="type">
         <property name="whatsThis">
          <string>&lt;p&gt;The projectile's type; this determines a lot of its hardcoded behavior.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Missile&lt;/b&gt; projectiles are the most appropriate for anything that travels in a straight line.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Lobbers&lt;/b&gt; were originally designed for grenades and mines in Fallout 3, and are used for runes in Skyrim.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Beams&lt;/b&gt; are the most appropriate for lightning spells.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Flames&lt;/b&gt; are used for any spells that produce a spray of projectiles.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Cones&lt;/b&gt; are ideal for most Shouts.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Barriers&lt;/b&gt; aren't used in Skyrim.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Arrows&lt;/b&gt; should be used for arrows i.e. pointy sticks what get fired from bows and crossbows.&lt;/p&gt;</string>
         </property>
         <item>
          <property name="text">
           <string>Missile</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Lobber</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Beam</string>
