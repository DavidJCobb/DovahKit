         </property>
         <layout class="QVBoxLayout" name="verticalLayout_8">
          <item>
           <widget class="DKFormListPane" name="perks">
            <property name="whatsThis">
             <string>&lt;p&gt;The perks that this actor has.&lt;/p&gt;
&lt;p&gt;Papyrus can be used to add or remove the player's perks, but not NPCs' perks; those are set in stone. If an NPC needs to be given a perk during play, you'll need to make it so that the NPC always has the perk (by adding it to this list), and then use conditions on the perk's entry points to limit when the perk actually does anything.&lt;/p&gt;</string>
            </property>
           </widget>
          </item>
         </layout>
