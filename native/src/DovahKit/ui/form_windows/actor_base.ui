          <item row="2" column="1">
           <widget class="QComboBox" name="assistance">
            <property name="whatsThis">
             <string>This option controls whether the actor will assist nearby actors that enter combat, based on the relationships it has with those actors.</string>
            </property>
            <property name="sizeAdjustPolicy">
             <enum>QComboBox::AdjustToContents</enum>
            </property>
            <item>
             <property name="text">
              <string>Helps Nobody</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Helps Allies</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Helps Friends and Allies</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="aggression">
            <property name="whatsThis">
             <string>&lt;p&gt;Controls how likely the actor is to attack nearby characters.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Unaggressive&lt;/span&gt; actors don't attack anyone unless provoked.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Aggressive&lt;/span&gt; actors attack enemies on sight.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Very Aggressive&lt;/span&gt; actors attack enemy and neutral characters on sight.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Frenzied&lt;/span&gt; actors attack everyone on sight.&lt;/p&gt;</string>
            </property>
            <item>
             <property name="text">
              <string>Unaggressive</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Aggressive</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Very Aggressive</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Frenzied</string>
             </property>
            </item>
           </widget>
          </item>
