       <item row="0" column="0" rowspan="3">
        <widget class="QGroupBox" name="groupBox_2">
         <property name="whatsThis">
          <string>&lt;p&gt;If PC Level Mult is disabled, then you can set the actor's level directly.&lt;/p&gt;
&lt;p&gt;If PC Level Mult is enabled, then you can set a multiplier, a minimum, and a maximum. The actor's level will be computed by applying the multiplier to the player's level, and clamping the result to fall within the minimum and maximum. For example, a multiplier of 2 would mean that the actor is at twice the player's level, unless that would fall below the actor's minimum level or above their maximum level.&lt;/p&gt;</string>
         </property>
         <property name="title">
          <string>Leveling Data</string>
         </property>
