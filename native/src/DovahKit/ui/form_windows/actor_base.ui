            <property name="text">
             <string>Assistance:</string>
            </property>
            <property name="buddy">
             <cstring>assistance</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_41">
            <property name="text">
             <string>Confidence:</string>
            </property>
            <property name="buddy">
             <cstring>confidence</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="confidence">
            <property name="whatsThis">
             <string>&lt;p&gt;Control how likely the actor is to flee from combat.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Cowardly&lt;/span&gt; actors never engage in combat, and always avoid or flee from threats.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Cautious&lt;/span&gt; actors avoid or flee from any threat they aren't certain they can defeat.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Average&lt;/span&gt; actors avoid or flee from threats if outmatched.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Brave&lt;/span&gt; actors avoid or flee from threats only if severely outmatched.&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Foolhardy&lt;/span&gt; actors never avoid or flee from a threat.&lt;/p&gt;</string>
            </property>
            <item>
             <property name="text">
              <string>Cowardly</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Cautious</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Average</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Brave</string>
             </property>
            </item>
            <item>
