      <layout class="QGridLayout" name="gridLayout_20">
       <item row="0" column="0">
        <layout class="QGridLayout" name="gridLayout_18">
         <item row="1" column="0">
          <widget class="QLabel" name="label_59">
           <property name="text">
            <string>Inherits Sounds From:</string>
           </property>
           <property name="buddy">
            <cstring>inheritSoundsFrom</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="0">
          <widget class="QLabel" name="label_58">
           <property name="text">
            <string>Sound Level:</string>
           </property>
           <property name="buddy">
            <cstring>soundLevel</cstring>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="DKFormPicker" name="inheritSoundsFrom">
           <property name="whatsThis">
            <string>&lt;p&gt;Actors can define their own creature sounds, or they can inherit creature sounds from another actor. You can specify an actor to inherit sounds from here. Alternatively, if you're using a template actor and have &quot;Use Traits&quot; enabled, creature sounds will be inherited from the template actor.&lt;/p&gt;
&lt;p&gt;If you select an actor here, you can only select one that does not, itself, inherit creature sounds.&lt;/p&gt;</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QComboBox" name="soundLevel">
           <property name="whatsThis">
            <string>This influences the effect that creature sounds have on stealth and detection. It does not affect the actual volume of the sounds.</string>
           </property>
           <property name="currentIndex">
            <number>1</number>
           </property>
           <item>
            <property name="text">
             <string>Silent</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Normal</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Loud</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Very Loud</string>
            </property>
           </item>
          </widget>
         </item>
        </layout>
       </item>
       <item row="0" column="1">
        <spacer name="horizontalSpacer_15">
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>321</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="1" column="0" colspan="2">
        <widget class="QGroupBox" name="groupBox_11">
         <property name="title">
          <string>Creature Sounds</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_19">
          <item row="0" column="1">
           <layout class="QVBoxLayout" name="verticalLayout_11">
            <item>
             <widget class="QPushButton" name="buttonCreaSoundAdd">
              <property name="text">
               <string>Add</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="buttonCreaSoundRemove">
              <property name="text">
               <string>Remove</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="verticalSpacer_13">
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>40</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
          <item row="1" column="0" colspan="2">
           <layout class="QHBoxLayout" name="horizontalLayout_8">
            <item>
             <widget class="QLabel" name="label_60">
              <property name="text">
               <string>Type:</string>
              </property>
              <property name="buddy">
               <cstring>currentCreaSoundType</cstring>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="currentCreaSoundType">
              <property name="whatsThis">
               <string>&lt;p&gt;In general, the various creature sound types are designed to play when specific animations occur. However, the system appears to be a leftover from &lt;i&gt;Fallout 3&lt;/i&gt; and &lt;i&gt;Fallout: New Vegas&lt;/i&gt;: it's functional, and creatures in Skyrim define some sounds, but none of those creatures' behavior graphs appear to trigger the animation events needed to actually play creature sounds. Bethesda seems to prefer mechanisms like &lt;code&gt;SoundPlay.SoundEditorIDHere&lt;/code&gt; animation events when they want to match sounds to animations.&lt;/p&gt;
&lt;dl&gt;
   &lt;dt&gt;&lt;b&gt;Attack&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;Plays when the &lt;code&gt;enum_attack&lt;/code&gt; animation event occurs.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;&lt;b&gt;Aware&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;Plays when the &lt;code&gt;enum_aware&lt;/code&gt; animation event occurs.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;&lt;b&gt;Death&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;Plays when the &lt;code&gt;enum_death&lt;/code&gt; animation event occurs.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;&lt;b&gt;Hit&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;Plays when the &lt;code&gt;enum_hit&lt;/code&gt; animation event occurs.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;&lt;b&gt;Idle&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;Plays when the &lt;code&gt;enum_idle&lt;/code&gt; animation event occurs.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;&lt;b&gt;Weapon&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;Plays when the &lt;code&gt;enum_weapon&lt;/code&gt; animation event occurs.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;&lt;b&gt;Conscious Loop&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;
         &lt;p&gt;The sound is played for as long as the creature is alive. The chance to play must be set to 100%, and the sound must be set to loop.&lt;/p&gt;
         &lt;p&gt;Internally, this appears to map to the &lt;code&gt;enum_awake&lt;/code&gt; animation event, so in theory, that event would also trigger this sound to play.&lt;/p&gt;
      &lt;/dd&gt;
   &lt;dt&gt;&lt;b&gt;Movement Loop&lt;/b&gt;&lt;/dt&gt;
      &lt;dd&gt;
         &lt;p&gt;The sound is played while the creature is moving. The chance to play must be set to 100%, and the sound must be set to loop.&lt;/p&gt;
         &lt;p&gt;Internally, this appears to map to the &lt;code&gt;enum_movement&lt;/code&gt; animation event.&lt;/p&gt;
      &lt;/dd&gt;
&lt;/dl&gt;</string>
              </property>
              <item>
               <property name="text">
                <string>Idle</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Aware</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Attack</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Hit</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Death</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Weapon</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Movement Loop</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Conscious Loop</string>
               </property>
              </item>
             </widget>
            </item>
            <item>
             <spacer name="horizontalSpacer_16">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeType">
               <enum>QSizePolicy::Fixed</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>16</width>
                <height>8</height>
               </size>
              </property>
             </spacer>
            </item>
            <item>
             <widget class="QLabel" name="label_61">
              <property name="text">
               <string>Chance:</string>
              </property>
              <property name="buddy">
               <cstring>currentCreaSoundChance</cstring>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="currentCreaSoundChance">
              <property name="whatsThis">
               <string>For sounds that are keyed to the creature's animations, this controls the likelihood that the sound will play each time the appropriate point in the animation is reached. This can be used to prevent excessive noise, for animations that play constantly or very frequently.</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
              </property>
              <property name="suffix">
               <string>%</string>
              </property>
              <property name="maximum">
               <number>100</number>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_62">
              <property name="text">
               <string>Sound:</string>
              </property>
              <property name="buddy">
               <cstring>currentCreaSoundForm</cstring>
              </property>
             </widget>
            </item>
            <item>
