             <property name="text">
              <string>Any Crime</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Violence Against Enemies</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Property Crimes Only</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>No Crime</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="2" column="0">
