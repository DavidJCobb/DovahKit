     <widget class="QWidget" name="tabAIPackages">
      <attribute name="title">
       <string>AI Packages</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_15">
       <item row="0" column="0" colspan="2">
        <widget class="QGroupBox" name="groupBox_5">
         <property name="title">
          <string>Packages</string>
         </property>
         <layout class="QHBoxLayout" name="horizontalLayout_6">
          <item>
           <widget class="QTableWidget" name="packageTable">
            <property name="whatsThis">
             <string>&lt;p&gt;If an actor is not in combat or a similar interrupt state, they will periodically evaluate their AI packages and decide what to do. They'll search through all of their AI packages and execute the first package they find whose conditions are met. They check the following lists of packages, from top to bottom:&lt;/p&gt;
&lt;ul&gt;
   &lt;li&gt;Packages associated with any Quest Aliases that refer to the actor.&lt;/li&gt;
   &lt;li&gt;Actor-specific packages (this listview).&lt;/li&gt;
   &lt;li&gt;The actor's Default Package List (below).&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;If there are no usable packages, then the actor will just stand around doing nothing.&lt;/p&gt;</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QVBoxLayout" name="verticalLayout_6">
            <item>
             <widget class="QPushButton" name="buttonAIPackageAdd">
              <property name="text">
               <string>Add</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="buttonAIPackageMoveUp">
              <property name="text">
               <string>Move Up</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="buttonAIPackageMoveDown">
              <property name="text">
               <string>Move Down</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="buttonAIPackageRemove">
              <property name="text">
               <string>Remove</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="verticalSpacer_10">
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>40</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QGroupBox" name="defaultPackagesGroupbox">
         <property name="title">
          <string>Default Package Lists</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_14">
          <item row="6" column="1">
           <widget class="DKFormPicker" name="packageListCombat">
            <property name="whatsThis">
             <string>Actors who enter combat will suspend all AI behavior until combat has ended. You can't control their behavior while in combat. However, if an actor is about to enter combat and this list contains a usable package, then they'll execute the first usable package instead of entering combat.</string>
            </property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="label_50">
            <property name="text">
             <string>Combat:</string>
            </property>
            <property name="buddy">
             <cstring>packageListCombat</cstring>
            </property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="label_48">
            <property name="text">
             <string>Observe Dead Body:</string>
            </property>
            <property name="buddy">
             <cstring>packageListObserveCorpse</cstring>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="label_49">
            <property name="text">
             <string>Guard Warn:</string>
            </property>
            <property name="buddy">
             <cstring>packageListGuardWarn</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="DKFormPicker" name="packageListDefault">
            <property name="whatsThis">
             <string>A list of packages that the actor will use whenever there are no usable actor-specific packages. Often, this list just consists of the &quot;default master package,&quot; which has common actor behaviors implemented.</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="DKFormPicker" name="packageListSpectator">
            <property name="whatsThis">
             <string>Actors who witness combat without participating in it become spectators. They'll suspend their normal AI behavior and execute the first usable package in this list; if no packages in this list are usable, then they'll fall back to hardcoded spectator behavior (usually fleeing).</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="DKFormPicker" name="packageListObserveCorpse">
            <property name="whatsThis">
             <string>Actors who discover a dead body will suspend their normal AI behavior and execute the first usable package in this list; if no packages in this list are usable, then they'll fall back to hardcoded behavior (usually approaching and inspecting the corpse).</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0" colspan="2">
           <widget class="Line" name="line_2">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="DKFormPicker" name="packageListGuardWarn">
            <property name="whatsThis">
             <string>Actors who are running a Guard package and enter the Warn behavior will execute the first usable package in this list; if no packages in this list are usable, then they'll fall back to the default Warn behavior.</string>
            </property>
           </widget>
          </item>
          <item row="0" column="0">
           <widget class="QLabel" name="label_46">
            <property name="text">
             <string>Defaults:</string>
            </property>
            <property name="buddy">
             <cstring>packageListDefault</cstring>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_47">
            <property name="text">
             <string>Spectator:</string>
            </property>
            <property name="buddy">
             <cstring>packageListSpectator</cstring>
            </property>
           </widget>
          </item>
          <item row="2" column="0" colspan="2">
