       <item>
        <widget class="QDoubleSpinBox" name="bleedoutDefault">
         <property name="whatsThis">
          <string>If an actor with this class is Essential or Protected, and their health drops below this proportion of their health, then they'll enter a &quot;bleedout&quot; state. A value of 1.0 represents 100% of the actor's health.</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
         <property name="maximum">
