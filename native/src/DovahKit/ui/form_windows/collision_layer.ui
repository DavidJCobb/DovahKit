   <item>
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>Collides with...</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_2">
      <item row="0" column="0">
       <widget class="DKFormListPane" name="collidesWith">
        <property name="whatsThis">
         <string>&lt;p&gt;Objects that belong to this collision layer can only collide with objects that belong to any collision layer in this list. You can drag and drop layers from the Object Window to add them to this list.&lt;/p&gt;
&lt;p&gt;Note that this implies that two objects in the same layer can only collide with each other if the layer is set to collide with itself.&lt;/p&gt;</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="gridLayout_3">
     <item row="1" column="0">
      <widget class="QCheckBox" name="checkBox_2">
       <property name="whatsThis">
        <string>Controls whether collision primitives in this layer should act as trigger volumes and fire trigger-related script events (e.g. OnTrigger).</string>
       </property>
       <property name="text">
        <string>Trigger Volume</string>
