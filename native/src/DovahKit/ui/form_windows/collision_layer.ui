     </item>
     <item row="2" column="0">
      <widget class="QCheckBox" name="checkBox_3">
       <property name="whatsThis">
        <string>Indicates whether collision geometry of this type should dynamically cut the navmesh. This is primarily intended for the &lt;code&gt;L_NAVCUT&lt;/code&gt; layer.</string>
       </property>
       <property name="text">
        <string>Navmesh Obstacle</string>
       </property>
      </widget>
     </item>
