     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="layerID">
       <property name="whatsThis">
        <string>A unique numeric ID for this layer. Collision data in NIF files can refer to the layer by this</string>
       </property>
       <property name="alignment">
        <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
       </property>
