    <layout class="QVBoxLayout" name="verticalLayout">
     <item>
      <widget class="QCheckBox" name="checkBox">
       <property name="whatsThis">
        <string>If checked, this music type will begin playing immediately, rather than waiting to fade out any already-playing music.</string>
       </property>
       <property name="text">
        <string>Abrupt transition</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="checkBox_2">
       <property name="whatsThis">
        <string>If checked, the game will play only one of this music type's tracks, when the music type is requested.</string>
       </property>
       <property name="text">
        <string>Plays one selection</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="checkBox_3">
       <property name="whatsThis">
        <string>If checked, this music type will continue to play tracks after its entire track list has played.</string>
       </property>
       <property name="text">
        <string>Cycle tracks</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="checkBox_4">
       <property name="whatsThis">
        <string>By default, music types play their tracks in a random order. If this option is checked, this music type will always play its music tracks in the order they're listed in below.</string>
       </property>
       <property name="text">
        <string>Maintain track order</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="checkBox_5">
       <property name="whatsThis">
        <string>If this music type begins playing while another, lower-priority, music type is playing, then the already-playing track will be ducked.</string>
       </property>
       <property name="text">
        <string>Ducks current track</string>
       </property>
      </widget>
     </item>
