     <item row="2" column="1">
      <widget class="QComboBox" name="type">
       <property name="whatsThis">
        <string>&lt;p&gt;This setting controls what part of a character's face this HeadPart defines.&lt;/p&gt;
&lt;p&gt;Most of these types are self-explanatory — eyes, eyebrows, and whatnot — but it's worth clarifying that &quot;Face&quot; defines an entire head NIF for an actor to use. The &quot;Misc&quot; type is generally used for HeadParts that exist only to serve as &quot;extra parts&quot; for other HeadParts (e.g. hairline meshes for hairstyles).&lt;/p&gt;</string>
       </property>
       <item>
        <property name="text">
         <string>Misc</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Face</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Eyes</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Hair</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Facial Hair</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Scar</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Eyebrows</string>
        </property>
       </item>
      </widget>
