     </item>
     <item row="3" column="1">
      <widget class="DKFormPicker" name="validRaces">
       <property name="whatsThis">
        <string>Specify a FormList of races that this HeadPart is compatible with. Actors of those races will be able to use the HeadPart. If you don't specify a list here, then the HeadPart will be usable by actors of any race.</string>
       </property>
      </widget>
     </item>
    </layout>
