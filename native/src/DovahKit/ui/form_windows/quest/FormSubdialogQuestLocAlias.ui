 <class>FormSubdialogQuestLocAlias</class>
 <widget class="QDialog" name="FormSubdialogQuestLocAlias">
  <property name="windowTitle">
   <string>Location Alias</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0">
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
