          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A Location Alias on this Quest. It must be higher in the list (lower ID number) than this alias.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
       </item>
       <item row="10" column="3">
        <widget class="QLabel" name="label_7">
         <property name="text">
          <string>Near Type:</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
         <property name="buddy">
          <cstring>findMatchingNearType</cstring>
         </property>
        </widget>
       </item>
       <item row="8" column="0">
        <layout class="QHBoxLayout" name="horizontalLayout_6">
         <item>
          <spacer name="horizontalSpacer_7">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeType">
            <enum>QSizePolicy::Maximum</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>30</width>
             <height>0</height>
            </size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QRadioButton" name="findMatchingModeLoadedArea">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The matching reference will be selected from the loaded area. If you use this option, you must specify at least one condition.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>...In Loaded Area</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item row="8" column="1">
        <widget class="QCheckBox" name="findMatchingFlagClosest">
         <property name="whatsThis">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If unchecked, the alias will be filled with an ObjectReference chosen randomly from all ObjectReferences in the loaded area that match the given conditions. If checked, the alias will be filled with the matching ObjectReference that is closest to the player-character.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Closest</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1" colspan="2">
        <widget class="DKCompactObjectReferencePicker" name="fillFromPredefined"/>
       </item>
       <item row="1" column="1" colspan="2">
        <widget class="DKFormPicker" name="fillFromUniqueActorBase"/>
