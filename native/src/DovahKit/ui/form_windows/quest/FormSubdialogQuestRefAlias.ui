       <item row="1" column="0" colspan="2">
        <layout class="QGridLayout" name="layoutFlags">
         <item row="1" column="1">
          <widget class="QCheckBox" name="flagAllowDead">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Normally, the Story Manager will not fill an alias with a dead Actor. This checkbox exempts this alias from that limitation.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>Allow Dead</string>
           </property>
          </widget>
         </item>
         <item row="1" column="2">
          <widget class="QCheckBox" name="flagAllowDisabled">
           <property name="text">
            <string>Allow Disabled</string>
           </property>
          </widget>
         </item>
         <item row="1" column="3">
          <widget class="QCheckBox" name="flagAllowReserved">
           <property name="text">
            <string>Allow Reserved</string>
           </property>
          </widget>
         </item>
         <item row="0" column="0">
          <widget class="QCheckBox" name="flagReserve">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If the quest is started via a Story Manager event, and if this alias &amp;quot;reserves&amp;quot; its ObjectReference, then the Story Manager will not fill any other alias with this ObjectReference unless one of the following is true: the other alias allows &amp;quot;reserved&amp;quot; ObjectReferences; the other alias uses the &amp;quot;Reference Alias on Other Quest&amp;quot; fill type; or the other alias belongs to a &amp;quot;Start Game Enabled&amp;quot; quest.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>Reserves Reference</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QCheckBox" name="flagAllowReuse">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Normally, when a quest is started via the Story Manager, the Story Manager will not fill multiple aliases with the same ObjectReference. This checkbox exempts this alias from that restriction.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>Allow Reuse in Quest</string>
           </property>
          </widget>
         </item>
         <item row="0" column="3">
          <widget class="QCheckBox" name="flagProtected">
           <property name="whatsThis">
            <string>If checked, an Actor used to fill this alias will be made Essential until they are no longer in the alias: it will be impossible for them to be killed by anything except the player, and they will enter a temporary &quot;bleedout&quot; state if their health is knocked to or below zero by something other than the player.</string>
           </property>
           <property name="text">
            <string>Protected</string>
           </property>
          </widget>
         </item>
         <item row="1" column="4">
          <widget class="QCheckBox" name="flagAllowDestroyed">
           <property name="whatsThis">
            <string>Controls whether references with destruction data can fill this alias while destroyed.</string>
           </property>
           <property name="text">
            <string>Allow Destroyed</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QCheckBox" name="flagOptional">
           <property name="whatsThis">
            <string>If this is checked, then the quest will be allowed to start even if this alias fails to fill. If this isn't checked, then the quest cannot start unless this alias fills successfully.</string>
           </property>
           <property name="text">
            <string>Optional</string>
           </property>
          </widget>
         </item>
         <item row="0" column="2">
          <widget class="QCheckBox" name="flagEssential">
           <property name="whatsThis">
            <string>If checked, an Actor used to fill this alias will be made Essential until they are no longer in the alias: it will be impossible for them to die by any means, and they will enter a temporary &quot;bleedout&quot; state if their health is knocked to or below zero.</string>
           </property>
           <property name="text">
            <string>Essential</string>
           </property>
          </widget>
         </item>
         <item row="0" column="4">
          <widget class="QCheckBox" name="flagQuestObject">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Items that are Quest Objects cannot be dropped or sold by the player, and can only be transferred to containers that are also Quest Objects. Containers that are Quest Objects will not be cleaned up by the game engine.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>Quest Object</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QCheckBox" name="flagUseStoredText">
           <property name="text">
            <string>Uses Stored Text</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QCheckBox" name="flagStoreText">
           <property name="text">
            <string>Stores Text</string>
           </property>
          </widget>
         </item>
         <item row="2" column="2">
          <widget class="QCheckBox" name="flagInitiallyDisabled">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If this is checked, the ObjectReference will automatically be disabled when it is assigned to this alias.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>Initially Disabled</string>
           </property>
          </widget>
         </item>
         <item row="2" column="3" colspan="2">
          <widget class="QCheckBox" name="flagClearNameWhenRemoved">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If checked, any Display Name assigned by this alias will be removed from the ObjectReference when the alias is cleared or refilled. If unchecked, the Display Name is permanent.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>Clears Name When Removed</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item row="2" column="0">
        <widget class="QGroupBox" name="groupBox">
         <property name="whatsThis">
          <string>&lt;p&gt;If the reference is an actor, it will be temporarily added to these factions when it fills this alias, and removed from these factions when it is removed from this alias.&lt;/p&gt;
&lt;p&gt;Note that if multiple aliases temporarily add an actor to the same faction, the actor will be removed from that faction when it is removed from &lt;em&gt;any&lt;/em&gt; of those aliases, even if it still fills the other aliases.&lt;/p&gt;</string>
         </property>
         <property name="title">
          <string>Factions</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_12">
          <item row="0" column="0">
           <widget class="DKFormListPane" name="factions">
