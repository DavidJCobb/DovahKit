        <widget class="QCheckBox" name="flagPlayable">
         <property name="whatsThis">
          <string>Items that are not playable will be hidden from in-game menus, and cannot be acquired or worn by the player.</string>
         </property>
         <property name="text">
          <string>Playable</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1" alignment="Qt::AlignLeft">
