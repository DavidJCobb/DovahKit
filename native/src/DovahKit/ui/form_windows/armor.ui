              </size>
             </property>
             <property name="whatsThis">
              <string>&lt;p&gt;The 3D model used to render this armor in the inventory menu and when it's dropped into the game world as an item. If you don't select a female model, then the male model is used as a default.&lt;/p&gt;
&lt;p&gt;To edit the 3D models used when the armor is actually worn by an actor, refer to the ArmorAddon forms that this armor relies on.&lt;/p&gt;</string>
             </property>
            </widget>
