            </property>
           </item>
          </widget>
         </item>
        </layout>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_10">
         <property name="text">
          <string>Enchantment:</string>
         </property>
         <property name="buddy">
          <cstring>enchantment</cstring>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="editorID"/>
       </item>
       <item row="2" column="1" alignment="Qt::AlignLeft">
        <widget class="QSpinBox" name="value">
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="DKFormPicker" name="templateForm">
         <property name="whatsThis">
          <string>&lt;p&gt;If this is set to another Armor form, then this armor will inherit all of its data except for the editor ID, name, value, and enchantment fields from the template. Inherited fields cannot be edited here.&lt;/p&gt;
&lt;p&gt;The main purpose of this option is to support variant armors, such as pre-made enchantments. Every pre-enchanted Daedric Helmet, for example, uses the non-enchanted Daedric Helmet form as a template, so that their baseline gameplay and art settings can all be edited in one place.&lt;/p&gt;</string>
         </property>
        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="label_12">
         <property name="text">
          <string>Weight:</string>
         </property>
         <property name="buddy">
          <cstring>weight</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_9">
         <property name="text">
          <string>Value:</string>
         </property>
         <property name="buddy">
          <cstring>value</cstring>
         </property>
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="label_13">
         <property name="text">
          <string>Armor Rating:</string>
         </property>
         <property name="buddy">
          <cstring>rating</cstring>
         </property>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="label_11">
         <property name="text">
