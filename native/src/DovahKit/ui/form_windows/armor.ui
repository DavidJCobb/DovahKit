          <item row="1" column="0" colspan="2">
           <widget class="DKFormDestructionDataButton" name="destructionData"/>
          </item>
          <item row="0" column="0">
           <widget class="QLabel" name="label_19">
            <property name="text">
             <string>Ragdoll Constraint Template:</string>
            </property>
            <property name="buddy">
             <cstring>ragdollConstraintTemplate</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="DKGameFilePicker" name="ragdollConstraintTemplate">
            <property name="whatsThis">
             <string>Ragdoll templates are defined in &lt;code&gt;*.rdt&lt;/code&gt; files, and are ea emans of applying new Havok constraint and rigid body data to an existing animation skeleton. The goal is to modify the characteristics of a ragdoll to reflect clothing or armor differences.</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QGroupBox" name="groupBox_2">
          <property name="title">
           <string>Item sounds</string>
          </property>
          <layout class="QGridLayout" name="gridLayout_5">
           <item row="0" column="0">
            <widget class="QLabel" name="label_17">
             <property name="text">
              <string>Take:</string>
             </property>
             <property name="buddy">
              <cstring>soundTake</cstring>
