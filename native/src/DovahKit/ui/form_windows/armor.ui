         <property name="buddy">
          <cstring>description</cstring>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="description">
         <property name="whatsThis">
          <string>An optional description for this item, which will be displayed in the &quot;item card&quot; widget in the inventory menu. If no description is provided and the armor has (or gains) an enchantment, then the description from that enchantment will be used.</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
    </layout>
   </item>
   <item row="0" column="1">
    <layout class="QGridLayout" name="gridLayout_7">
     <item row="0" column="0" colspan="2">
      <widget class="QGroupBox" name="groupBox_4">
       <property name="whatsThis">
        <string>&lt;p&gt;Armor forms can be made compatible with multiple races, and must specify which of a race's body parts they equip to. Actors of a given race can equip a piece of armor if that armor is set to equip to at least one of that race's body parts. (Alternatively, one race can specify another race as its &quot;armor race,&quot; to inherit the latter race's wearable armor.) An actor can only equip one armor to a given body part; if they try to equip another armor to the same body part, then the previous armor is automatically unequipped.&lt;/p&gt;
&lt;p&gt;To edit this data, first select a race, to view its list of body parts. Then, check and uncheck body parts as desired. Note that playable armors always rely on DefaultRace.&lt;/p&gt;</string>
       </property>
       <property name="title">
        <string>Armor equips to body parts...</string>
       </property>
       <layout class="QGridLayout" name="gridLayout_9">
        <item row="0" column="0">
         <widget class="QLabel" name="label_20">
          <property name="text">
           <string>Edit for Race:</string>
          </property>
          <property name="buddy">
           <cstring>bipedObjectsCurrentRace</cstring>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="DKFormPicker" name="bipedObjectsCurrentRace">
          <property name="allowNone">
           <bool>false</bool>
          </property>
         </widget>
        </item>
        <item row="1" column="0" colspan="2">
         <widget class="QListView" name="bipedObjectsCurrentList">
          <property name="minimumSize">
           <size>
            <width>100</width>
            <height>0</height>
           </size>
          </property>
          <property name="baseSize">
           <size>
            <width>120</width>
            <height>0</height>
           </size>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
