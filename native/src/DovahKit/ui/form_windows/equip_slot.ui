  <property name="windowTitle">
   <string>Equip Slot</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0">
    <widget class="QLabel" name="label">
     <property name="text">
      <string>Editor ID:</string>
     </property>
     <property name="buddy">
      <cstring>editorID</cstring>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QLineEdit" name="editorID"/>
   </item>
   <item row="1" column="0" colspan="2">
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>Slot Parents</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_2">
      <item row="0" column="0">
       <widget class="DKFormListPane" name="parents">
        <property name="whatsThis">
         <string>&lt;p&gt;It's possible to define one Equip Slot in terms of other Equip Slots, such that the one equip slot overlaps some or all of those other equip slots. Some examples:&lt;/p&gt;
&lt;ul&gt;
   &lt;li&gt;&lt;p&gt;The EitherHand and BothHands slots both use LeftHand and RightHand as their parents. The difference between them is the &quot;Use All Parents&quot; checkbox.&lt;/p&gt;&lt;/li&gt;
   &lt;li&gt;&lt;p&gt;The Shield slot has LeftHand as its sole parent. This means that actors can only equip a shield to their left hand, and that they can't equip other items to their left hand at the same time.&lt;/p&gt;&lt;/li&gt;
&lt;/ul&gt;</string>
        </property>
        <property name="showFormTypes">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="flagUseAllParents">
        <property name="whatsThis">
         <string>&lt;p&gt;If the Use All Parents box is checked, then this Equip Slot takes up all of the parent slots. Otherwise, it can take up any one of the parent slots.&lt;/p&gt;
&lt;p&gt;Some examples:&lt;/p&gt;
&lt;p&gt;The vanilla BothHands slot has the parent slots LeftHand and RightHand, and Use All Parents is checked. This means that any item marked with the BothHands slot takes up both the left and right hands: it's a two-handed item.&lt;/p&gt;
&lt;p&gt;The vanilla EitherHand slot has the parent slots LeftHand and RightHand, and Use All Parents is not checked. This means that any item marked with the EitherHand slot can be equipped to either hand. The only circumstance under which the item would take up both hands is if you equip two if the item, one to each hand.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Use All Parents</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <layout class="QHBoxLayout" name="horizontalLayout">
     <item>
      <spacer name="horizontalSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="buttonOK">
       <property name="text">
        <string>OK</string>
       </property>
      </widget>
     </item>
     <item>
