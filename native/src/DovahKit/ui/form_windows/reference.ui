       </item>
       <item>
        <widget class="QGroupBox" name="flagsGroupbox">
         <property name="title">
          <string>Miscellaneous options</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_2">
          <item row="7" column="0">
           <widget class="QCheckBox" name="flagMotionBlur">
            <property name="whatsThis">
             <string>Unused.</string>
            </property>
            <property name="text">
             <string>Motion Blur</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QCheckBox" name="flagIgnoredBySandbox">
            <property name="whatsThis">
             <string>If checked, NPCs running a &quot;Sandbox&quot; AI procedure will ignore this ref instead of interacting with it.</string>
            </property>
            <property name="text">
             <string>Ignored By Sandbox</string>
            </property>
           </widget>
          </item>
          <item row="0" column="0">
           <widget class="QCheckBox" name="flagDontHavokSettle">
            <property name="whatsThis">
             <string>&lt;p&gt;By default, refs will undergo physics simulation from the moment they spawn. Checking this box will delay the ref's physics simulation until any objects undergo physics interactions near the ref.&lt;/p&gt;
&lt;p&gt;If you want to completely lock a ref in place, then attach the &lt;code&gt;defaultDisableHavokOnLoad&lt;/code&gt; script to it.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Don't Havok Settle</string>
            </property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QCheckBox" name="flagIsFullLOD">
            <property name="whatsThis">
             <string>If checked, this ref won't fade out from a distance. This is primarily useful for large refs and lighting to prevent awkward LOD transitions, but using this too much can impact performance.</string>
            </property>
            <property name="text">
             <string>Is Full LOD</string>
            </property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QCheckBox" name="flagDoorInaccessible">
            <property name="whatsThis">
             <string>Only applicable to doors. If checked, the door will be impossible to unlock or open, displaying &quot;Requires Key&quot; as its lock status. (In the Fallout games, it would've displayed &quot;Inaccessible.&quot;) This overrides any lock-related options set on the door.</string>
            </property>
            <property name="text">
             <string>Inaccessible</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QCheckBox" name="flagHiddenFromLocalMap">
            <property name="whatsThis">
             <string>&lt;p&gt;If checked, this ref won't be rendered on the Local Map's top-down view.&lt;/p&gt;
&lt;p&gt;This is most useful for hiding clutter from the Local Map to keep it readable. If you want to hide large areas, an easier method is to place &lt;code&gt;BlackPlane01&lt;/code&gt; refs above them.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Hidden from Local Map</string>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QCheckBox" name="flagDisabled">
            <property name="whatsThis">
             <string>A &quot;disabled&quot; ref is not simulated or rendered by the game world; it is effectively &quot;not there.&quot; Refs can be disabled and later enabled by scripts and game events.</string>
            </property>
            <property name="text">
             <string>Initially Disabled</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QCheckBox" name="flagNoAIAcquire">
            <property name="whatsThis">
             <string>NPCs won't try to pick up items, or loot containers, that have this option enabled.</string>
            </property>
            <property name="text">
             <string>No AI Acquire</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QCheckBox" name="flagOpenByDefault">
            <property name="whatsThis">
             <string>Only applicable to containers and doors. If enabled, the container or door will initially be open.</string>
            </property>
            <property name="text">
             <string>Open by Default</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QCheckBox" name="flagReflectedByAutoWater">
            <property name="whatsThis">
             <string>Unused in Skyrim. In previous games, this controlled whether a ref could be seen in reflections on the surface of exterior cells' water planes (&quot;auto water&quot;).</string>
            </property>
            <property name="text">
             <string>Reflected by Auto Water</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QCheckBox" name="flagRespawns">
            <property name="whatsThis">
             <string>If unchecked, the game engine will &lt;em&gt;try&lt;/em&gt; to prevent the object from respawning even if the cell it's inside of should reset.</string>
            </property>
            <property name="text">
             <string>Respawns</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QCheckBox" name="flagStartsDead">
            <property name="whatsThis">
             <string>Only applicable to actors. Makes the actor spawn as a corpse rather than as a living character. (Simply spawning them with zero health is not sufficient to achieve the same effect.)</string>
            </property>
            <property name="text">
             <string>Starts Dead</string>
            </property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QCheckBox" name="flagTurnOffFire">
            <property name="text">
             <string>Turn Off Fire</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <layout class="QGridLayout" name="gridLayout_6">
         <item row="2" column="0">
          <widget class="QLabel" name="label_9">
           <property name="text">
            <string>Location Ref Type:</string>
           </property>
           <property name="buddy">
            <cstring>locRefType</cstring>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_15">
           <property name="text">
            <string>Persist Location:</string>
           </property>
           <property name="buddy">
            <cstring>persistLocation</cstring>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="DKFormPicker" name="locRefType">
           <property name="whatsThis">
            <string>&lt;p&gt;When a ref is present in a Location and is tagged with a Location Ref Type, the game's fill-in-the-blank Radiant Story system can use that Location Ref Type to find the ref, even when the ref isn't in the game's loaded area. Quest aliases can dynamically select a Location based on what Location Ref Types are used within it, and then dynamically select refs within that Location by their Location Ref Types. For example, a location can be given an actor with the &quot;Boss&quot; Location Ref Type, and then if a quest happens to target that location, the quest can dynamically offer a quest objective directing the player to kill that actor.&lt;/p&gt;</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="DKFormPicker" name="persistLocation">
           <property name="whatsThis">
            <string>Only applicable to actors, normal or leveled.</string>
           </property>
          </widget>
         </item>
         <item row="0" column="0">
          <widget class="QLabel" name="label_10">
           <property name="text">
            <string>Encounter Zone:</string>
           </property>
           <property name="buddy">
            <cstring>encounterZone</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="DKFormPicker" name="encounterZone">
           <property name="whatsThis">
            <string>Encounter Zones are primarily used by leveled lists to calculate what object should spawn. By default, refs belong to whatever Encounter Zone their containing cell belongs to, but you can override that here.</string>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="xLevCreaModLabel">
           <property name="text">
            <string>Level Modifier:</string>
           </property>
           <property name="buddy">
            <cstring>xLevCreaMod</cstring>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QComboBox" name="xLevCreaMod">
           <property name="whatsThis">
            <string>Only applicable to leveled actors. Scales the actor's level relative to that of the surrounding Encounter Zone.</string>
           </property>
           <item>
            <property name="text">
             <string>Easy</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Medium</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Hard</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Very Hard</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>None</string>
            </property>
           </item>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="verticalSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>0</width>
           <height>0</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="pageExtra">
      <layout class="QGridLayout" name="gridLayout_9">
       <item row="9" column="0">
        <widget class="QLabel" name="label_19">
         <property name="text">
          <string>Time Left:</string>
         </property>
         <property name="buddy">
          <cstring>xTimeLeft</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QCheckBox" name="xChargePresent">
         <property name="whatsThis">
          <string>Only applicable to enchanted weapons. Controls the amount of charge present on the weapon. If absent, the weapon is fully charged.</string>
         </property>
         <property name="text">
          <string>Charge</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QDoubleSpinBox" name="xHeadtrackingWeight">
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
         <property name="value">
