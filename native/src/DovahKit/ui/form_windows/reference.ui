         </property>
        </widget>
       </item>
       <item row="9" column="1">
        <widget class="QDoubleSpinBox" name="xTimeLeft">
         <property name="whatsThis">
          <string>Only applicable to lights. For lights that are capable of burning out, this is the amount of time remaining until this specific ref burns out.</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="DKCompactObjectReferencePicker" name="xAttachRef">
         <property name="whatsThis">
          <string>You can optionally synchronize this ref's movement to that of some other ref. This is useful when the latter ref has animations created for the purpose. This functionality isn't used in Skyrim.</string>
         </property>
        </widget>
       </item>
       <item row="7" column="0">
        <widget class="QLabel" name="xHorseLabel">
         <property name="text">
          <string>Horse:</string>
         </property>
         <property name="buddy">
          <cstring>xHorse</cstring>
         </property>
        </widget>
       </item>
       <item row="0" column="0">
        <widget class="QLabel" name="label_16">
         <property name="text">
          <string>Alpha Cutoff:</string>
         </property>
         <property name="buddy">
          <cstring>xAlphaCutoff</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QDoubleSpinBox" name="xCharge">
         <property name="whatsThis">
          <string>Only applicable to enchanted weapons. Controls the amount of charge present on the weapon. If absent, the weapon is fully charged.</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
        </widget>
       </item>
       <item row="10" column="0">
        <spacer name="verticalSpacer_3">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>205</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="3" column="1">
        <widget class="QSpinBox" name="xCount">
         <property name="whatsThis">
          <string>&lt;p&gt;A single ref can represent a single item, or multiple of an item. For example, if the player drops ten Iron Ingots all at once, the game will spawn just one ref. When the player aims at it, they'll see &quot;Iron Ingot (10).&quot; You can control how many items this ref represents here.&lt;/p&gt;
&lt;p&gt;If this ref is an Ammo, then its 3D model will change depending on whether the count is 1 or more. This special behavior is hardcoded for Ammo forms only, and is used by the vanilla game to switch between rendering a single arrow or rendering a quiver full of them. There exists at least one SKSE64 mod as of this writing (Dynamic Stacked Object Models) which extends this functionality to arbitrary base forms.&lt;/p&gt;</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
         <property name="minimum">
          <number>1</number>
         </property>
         <property name="maximum">
          <number>99999999</number>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_22">
         <property name="text">
          <string>Attach Ref:</string>
         </property>
         <property name="buddy">
          <cstring>xAttachRef</cstring>
         </property>
        </widget>
       </item>
       <item row="9" column="2">
        <widget class="QPushButton" name="xTimeLeftReset">
         <property name="whatsThis">
          <string>Reset &quot;Time Left&quot; to the default value: the max lifespan of the ref's base Light form.</string>
         </property>
         <property name="text">
          <string>Reset</string>
         </property>
        </widget>
       </item>
       <item row="7" column="1" colspan="2">
        <widget class="DKCompactObjectReferencePicker" name="xHorse">
         <property name="whatsThis">
          <string>Only applicable to actors. You can assign to any placed actor a horse ref for them to ride.</string>
         </property>
        </widget>
       </item>
       <item row="8" column="0" colspan="3">
        <widget class="QCheckBox" name="flagIsSkyMarker">
         <property name="whatsThis">
          <string>Only applicable to &lt;code&gt;XMarkerHeading&lt;/code&gt; refs. Indicates that the marker is a point in the air that can be used in a dragon's flight path.</string>
         </property>
         <property name="text">
          <string>Is Sky Marker</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
