                 <cstring>testRadius</cstring>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QDoubleSpinBox" name="testRadius">
                <property name="whatsThis">
                 <string>&lt;p&gt;If you set this to a non-zero value, the Creation Kit will display rings (with the given radius) around this ref. This is useful for estimating distances for packages and scripts. This value is not saved.&lt;/p&gt;</string>
                </property>
                <property name="alignment">
                 <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
                </property>
               </widget>
              </item>
