       <item row="0" column="1">
        <widget class="QSpinBox" name="xAlphaCutoff">
         <property name="whatsThis">
          <string>This value can override the alpha-testing threshold used by the ref's 3D model. The typical use case for this is to make banners and carpets appear more tattered than usual.</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
