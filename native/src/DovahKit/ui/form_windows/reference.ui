        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item row="2" column="0">
        <spacer name="verticalSpacer_8">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>434</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="0" column="1">
        <widget class="DKFormPicker" name="xLeveledItemBase">
         <property name="whatsThis">
          <string>&lt;p&gt;Leveled Item forms aren't base forms, and can't be placed directly in the game world. The necessary approach is to place an ordinary item, and then use this option so that the ref spawns as the desired leveled item instead of as its actual base form. Bethesda has created a bunch of &quot;dummy&quot; forms, e.g. &lt;code&gt;DummyPotion&lt;/code&gt;, for use as the base forms of leveled item spawn points.&lt;/p&gt;</string>
         </property>
        </widget>
       </item>
       <item row="0" column="0">
        <widget class="QLabel" name="label_32">
         <property name="text">
          <string>Replace with Leveled Item:</string>
         </property>
         <property name="buddy">
          <cstring>xLeveledItemBase</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_33">
         <property name="text">
          <string>Spawn in Container:</string>
         </property>
         <property name="buddy">
          <cstring>xSpawnContainer</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="DKCompactObjectReferencePicker" name="xSpawnContainer">
         <property name="whatsThis">
          <string>&lt;p&gt;If you set a container here, then this ref will be moved into the container when spawned.&lt;/p&gt;
&lt;p&gt;This is useful for adding bespoke items to a specific container ref without having to define a new Container base form. For example, in the base game, a traumatized war veteran named Salvanius lives in the Riften Ratway, and he stores his Imperial Cuirass and Imperial Gauntlets in a nearby chest. The chest itself uses a typical container base form with leveled loot; these two pieces of Salvanius's old armor are refs placed out of bounds, set to use that chest as their Spawn Container. This avoids the need to create an entire new Container base form just to spawn Salvanius's armor.&lt;/p&gt;</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
