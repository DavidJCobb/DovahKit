        <number>0</number>
       </property>
       <item row="0" column="0">
        <widget class="QLabel" name="label_13">
         <property name="text">
          <string>Owner:</string>
         </property>
         <property name="buddy">
          <cstring>owner</cstring>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="DKFormPicker" name="owner">
         <property name="whatsThis">
          <string>&lt;p&gt;This ref can be made to belong to an ActorBase or a Faction. If no owner is set here, then the ref will belong to whatever Actor or Faction, if any, owns its containing cell.&lt;/p&gt;
&lt;p&gt;Furniture with an owner can only be used by its owner. Items with an owner can be picked up by anyone, but if someone who doesn't own them picks them up, that individual will be committing theft.&lt;/p&gt;</string>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <spacer name="verticalSpacer_2">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>437</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_14">
         <property name="text">
          <string>Minimum Rank:</string>
         </property>
         <property name="buddy">
          <cstring>ownerRank</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QComboBox" name="ownerRank">
         <property name="whatsThis">
          <string>&lt;p&gt;If this ref is owned by a Faction, you can specify the minimum rank that a faction member must have in order to be regarded as sharing ownership of this ref. (Skyrim's factions don't use the rank system.)&lt;/p&gt;</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="pageItem">
      <layout class="QGridLayout" name="gridLayout_21">
       <property name="leftMargin">
        <number>0</number>
       </property>
