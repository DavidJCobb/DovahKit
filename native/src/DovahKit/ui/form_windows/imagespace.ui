 <class>FormDialogImagespace</class>
 <widget class="QDialog" name="FormDialogImagespace">
  <property name="windowTitle">
   <string>Imagespace</string>
  </property>
  <layout class="QGridLayout" name="gridLayout_4">
   <item row="0" column="0" rowspan="2">
    <widget class="QGroupBox" name="groupboxHDR">
     <property name="whatsThis">
      <string>Skyrim uses high dynamic range rendering. Put simply, the game's 3D renderer can produce colors that are brighter than white or darker than black, and the options here are used afterward to control how those visuals are shifted into the range of colors that an ordinary monitor can display.</string>
     </property>
     <property name="title">
      <string>HDR</string>
     </property>
     <layout class="QGridLayout" name="gridLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="label">
        <property name="text">
         <string>Eye Adapt Speed:</string>
        </property>
        <property name="buddy">
         <cstring>hdrEyeAdaptSpeed</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="hdrEyeAdaptSpeed">
        <property name="whatsThis">
         <string>&lt;p&gt;Controls how quickly the adapted scene luminance chases the actual luminance. The value is the percentage of the difference, measured over thirtieths of a second (i.e. the percentage of the gap that is closed every frame at 30FPS). Typical values are in the range [2%, 5%], with the default being 3%.&lt;/p&gt;
&lt;p&gt;A vale of 0 means that the adapted luminance will never change. A value of 100 means that the adapted luminance changes in real-time.&lt;/p&gt;</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
        <property name="suffix">
         <string>%</string>
        </property>
        <property name="maximum">
         <double>100.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_2">
        <property name="text">
         <string>Eye Adapt Strength:</string>
        </property>
        <property name="buddy">
         <cstring>hdrEyeAdaptStrength</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="hdrEyeAdaptStrength">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_3">
        <property name="text">
         <string>Bloom Blur Radius:</string>
        </property>
        <property name="buddy">
         <cstring>hdrBloomRadius</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="hdrBloomRadius">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
        <property name="minimum">
         <double>1.000000000000000</double>
        </property>
        <property name="maximum">
         <double>7.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="label_4">
        <property name="text">
         <string>Bloom Threshold:</string>
        </property>
        <property name="buddy">
         <cstring>hdrBloomThreshold</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="hdrBloomThreshold">
        <property name="whatsThis">
         <string>Controls how bright a pixel in the scene has to be in order to bloom. Pixels darker than this threshold don't bloom, while pixels brighter than this value bloom more the further above the threshold they are.</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="label_5">
        <property name="text">
         <string>Bloom Scale:</string>
