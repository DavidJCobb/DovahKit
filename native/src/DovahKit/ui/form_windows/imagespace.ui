      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="cineSaturation">
        <property name="whatsThis">
         <string>Control the saturation of the scene. Negative values invert the scene colors. A zero value forces the scene to greyscale.</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="cineTintAmount">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
        <property name="maximum">
         <double>255.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_14">
        <property name="text">
         <string>Contrast:</string>
        </property>
        <property name="buddy">
         <cstring>cineContrast</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="cineContrast">
        <property name="whatsThis">
         <string>&lt;p&gt;Values above 1 will make dark pixels darker and light pixels lighter. Positive values lower than one will instead soften the differences. Negative values invert the brightness of pixels, before then scaling brightness and darkness similarly to postiive values.&lt;/p&gt;</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="cineBrightness">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
        <property name="maximum">
         <double>100.000000000000000</double>
        </property>
       </widget>
      </item>
