        <widget class="QCheckBox" name="flagIsMarker">
         <property name="whatsThis">
          <string>If this furniture is flagged as a marker, then its 3D model won't be loaded during play.</string>
         </property>
         <property name="text">
          <string>Is Marker</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QCheckBox" name="flagMustExitToTalk">
         <property name="whatsThis">
          <string>&lt;p&gt;If this option is enabled, then NPCs can't talk to the player while using this furniture. If the player tries to strike up a conversation, they'll exit this furniture before responding.&lt;/p&gt;
&lt;p&gt;The most common use cases for this are beds and resource harvesting furniture: you don't usually want actors to continue lying in bed, or chopping wood, while speaking to the player.&lt;/p&gt;</string>
         </property>
         <property name="text">
          <string>Must Exit to Talk</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QCheckBox" name="flagIsPerch">
         <property name="text">
