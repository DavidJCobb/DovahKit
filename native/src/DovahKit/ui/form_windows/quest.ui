     <widget class="QWidget" name="tabDialogue">
      <attribute name="title">
       <string>Dialogue</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_5">
       <item row="1" column="0">
        <widget class="QTabWidget" name="dialogueTabbox">
         <property name="currentIndex">
          <number>0</number>
         </property>
         <widget class="QWidget" name="tabDialoguePlayer">
