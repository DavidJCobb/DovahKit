              <item>
               <widget class="QCheckBox" name="stageFlagStartup">
                <property name="whatsThis">
                 <string>If this box is checked, then this Quest Stage's Items will run every time the quest starts, even if the quest was started by directly &lt;code&gt;SetStage&lt;/code&gt;ing it to a different Quest Stage number.</string>
                </property>
                <property name="text">
                 <string>Startup Stage</string>
                </property>
               </widget>
              </item>
              <item>
               <spacer name="horizontalSpacer_8">
