                </property>
                <property name="sizeType">
                 <enum>QSizePolicy::Fixed</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>8</width>
                  <height>0</height>
                 </size>
                </property>
               </spacer>
              </item>
              <item>
               <widget class="QCheckBox" name="stageFlagShutdown">
                <property name="whatsThis">
                 <string>If this box is checked, then this Quest Stage's Items will be run every time the quest stops.</string>
                </property>
                <property name="text">
                 <string>Shutdown Stage</string>
                </property>
               </widget>
              </item>
              <item>
               <spacer name="horizontalSpacer_9">
                <property name="orientation">
                 <enum>Qt::Horizontal</enum>
                </property>
                <property name="sizeType">
                 <enum>QSizePolicy::Fixed</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>8</width>
                  <height>0</height>
                 </size>
                </property>
               </spacer>
              </item>
              <item>
               <widget class="QCheckBox" name="stageFlagKeepInstanceData">
                <property name="whatsThis">
                 <string>&lt;p&gt;If this quest uses Text Replacement, then this flag is required in order to preserve text replacement data in the player's save file. Checking this box will trigger the quest to begin writing that data to the savegame once this Quest Stage has been activated.&lt;/p&gt;</string>
                </property>
                <property name="text">
                 <string>Keep instance data from here on</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item>
             <widget class="QGroupBox" name="groupBox_3">
              <property name="whatsThis">
               <string>&lt;p&gt;Quest Stage Items are groups of conditional effects that can occur when a Quest Stage is activated. A single Quest Stage can have multiple Quest Stage Items, each able to specify a log entry, a Papyrus fragment, and other parameters.&lt;/p&gt;</string>
              </property>
              <property name="title">
               <string>Quest Stage Items</string>
              </property>
