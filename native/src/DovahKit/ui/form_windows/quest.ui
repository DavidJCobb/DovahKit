                 </item>
                 <item>
                  <spacer name="verticalSpacer_2">
                   <property name="orientation">
                    <enum>Qt::Vertical</enum>
                   </property>
                   <property name="sizeHint" stdset="0">
                    <size>
                     <width>20</width>
                     <height>40</height>
                    </size>
                   </property>
                  </spacer>
                 </item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="groupBox_2">
              <property name="title">
               <string>Selected Quest Stage Item</string>
              </property>
              <layout class="QVBoxLayout" name="verticalLayout_6">
               <item>
                <layout class="QHBoxLayout" name="horizontalLayout_6">
                 <item>
                  <layout class="QGridLayout" name="gridLayout_12">
                   <item row="2" column="2">
                    <widget class="QLabel" name="label_16">
                     <property name="text">
                      <string>Next quest (unused):</string>
                     </property>
                     <property name="buddy">
                      <cstring>logEntryNextQuest</cstring>
                     </property>
                    </widget>
                   </item>
                   <item row="3" column="2">
                    <widget class="DKFormPicker" name="logEntryNextQuest">
                     <property name="whatsThis">
                      <string>This is not used.</string>
                     </property>
                    </widget>
                   </item>
                   <item row="1" column="0" colspan="3">
                    <widget class="QPlainTextEdit" name="logEntryText">
                     <property name="whatsThis">
                      <string>If a Quest Stage Item has Log Entry text, then that text will become the quest's summary in the player's journal menu. Only the most recent Log Entry is displayed to the player.</string>
                     </property>
                    </widget>
                   </item>
                   <item row="3" column="0">
                    <widget class="QCheckBox" name="logEntryFail">
                     <property name="whatsThis">
                      <string>&lt;p&gt;If this box is checked, then the activation of this Quest Stage Item will trigger the &quot;Quest Failed&quot; UI pop-up, and move the quest from the &quot;active quests&quot; section of the player's journal menu to the &quot;completed quests&quot; section.&lt;/p&gt;
&lt;p&gt;This is purely a cosmetic effect. The quest will continue running unless stopped by script.&lt;/p&gt;</string>
                     </property>
                     <property name="text">
                      <string>Fail Quest</string>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="0" colspan="3">
                    <widget class="QLabel" name="label_15">
                     <property name="text">
                      <string>Log Entry:</string>
                     </property>
                     <property name="buddy">
                      <cstring>logEntryText</cstring>
                     </property>
                    </widget>
                   </item>
                   <item row="2" column="0">
                    <widget class="QCheckBox" name="logEntryComplete">
                     <property name="whatsThis">
                      <string>&lt;p&gt;If this box is checked, then the activation of this Quest Stage Item will trigger the &quot;Quest Completed&quot; UI pop-up, and move the quest from the &quot;active quests&quot; section of the player's journal menu to the &quot;completed quests&quot; section.&lt;/p&gt;
&lt;p&gt;This is purely a cosmetic effect. The quest will continue running unless stopped by script.&lt;/p&gt;</string>
                     </property>
                     <property name="text">
                      <string>Complete Quest</string>
                     </property>
                    </widget>
                   </item>
                   <item row="2" column="1">
                    <spacer name="horizontalSpacer_10">
                     <property name="orientation">
