         <item>
          <widget class="QGroupBox" name="embedded">
           <property name="whatsThis">
            <string>&lt;p&gt;This functionality isn't used in Skyrim.&lt;/p&gt;
&lt;p&gt;For Fallout 3 and Fallout: New Vegas, this data is used for weapons that are built-in parts of a creature. It allows the weapon to be attached to a specific node in the wielder's animation skeleton, and it allows the weapon to be targeted in VATS, using a given actor value on the wielder.&lt;/p&gt;</string>
           </property>
           <property name="title">
            <string>Embedded weapon</string>
           </property>
           <property name="checkable">
            <bool>true</bool>
           </property>
           <property name="checked">
