     </item>
     <item row="5" column="1">
      <widget class="DKFormPicker" name="templateForm">
       <property name="whatsThis">
        <string>&lt;p&gt;If this is set to another Weapon form, then this weapon will inherit all of its Game Data and Art and Sound options from that other weapon, and you will not be able to alter those options here.&lt;/p&gt;
&lt;p&gt;The main purpose of this option is to support variant weapons, such as pre-made enchantments. Every pre-enchanted Daedric Battleaxe, for example, uses the non-enchanted Daedric Battleaxe form as a template, so that their baseline gameplay and art settings can all be edited in one place.&lt;/p&gt;</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
