       <item row="0" column="1">
        <layout class="QVBoxLayout" name="gameDataColumnRight">
         <item>
          <widget class="QGroupBox" name="groupBox">
           <property name="title">
            <string>Flags</string>
           </property>
           <layout class="QGridLayout" name="gridLayout_2">
            <item row="0" column="0">
             <widget class="QCheckBox" name="flagNPCsUseAmmo">
              <property name="whatsThis">
               <string>By default, NPCs don't use up any of the ammo in their inventory. If this box is checked, however, then NPCs will consume ammo while using this weapon.</string>
              </property>
              <property name="text">
               <string>NPCs use ammo</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QCheckBox" name="flagNoJam">
              <property name="whatsThis">
               <string>Unused.</string>
              </property>
              <property name="text">
               <string>No jam after reload</string>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QCheckBox" name="flagIgnoresNormalResist">
              <property name="whatsThis">
               <string>Unused?</string>
              </property>
              <property name="text">
               <string>Ignores normal weapon resistance</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QCheckBox" name="flagMinorCrime">
              <property name="whatsThis">
               <string>Ordinarily, attacking an NPC is an assault — a major crime. If this box is checked, however, then attacking an NPC with this weapon will only be a minor crime.</string>
              </property>
              <property name="text">
               <string>Minor crime</string>
              </property>
             </widget>
            </item>
            <item row="2" column="0">
             <widget class="QCheckBox" name="flagAutomatic">
              <property name="whatsThis">
               <string>Unused?</string>
              </property>
              <property name="text">
               <string>Automatic</string>
              </property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="QCheckBox" name="flagHideBackpack">
              <property name="whatsThis">
               <string>If checked, the weapon will be invisible while sheathed, and only visible when it is drawn and held in one or both hands.</string>
              </property>
              <property name="text">
               <string>Hide backpack</string>
              </property>
             </widget>
            </item>
            <item row="3" column="0">
             <widget class="QCheckBox" name="flagCantDrop">
              <property name="whatsThis">
               <string>If this is checked, then an actor using this weapon cannot be disarmed, and the weapon isn't dropped when the actor dies. This option is intended for weapons that are mounted onto the actor or its armor.</string>
              </property>
              <property name="text">
               <string>Can't drop</string>
              </property>
             </widget>
            </item>
            <item row="3" column="1">
             <widget class="QCheckBox" name="flagPlayable">
              <property name="whatsThis">
               <string>If checked, the player can see this weapon in other actors' inventories, and can equip and use it. If unchecked, the player cannot see the weapon listed in inventory menus, and cannot equip it.</string>
              </property>
              <property name="text">
               <string>Playable</string>
              </property>
             </widget>
            </item>
            <item row="4" column="0">
             <widget class="QCheckBox" name="flagNotUsedInNormalCombat">
              <property name="whatsThis">
               <string>If checked, NPCs will never use this weapon unless a Use Weapon AI package directs them to.</string>
              </property>
              <property name="text">
               <string>Not used in normal combat</string>
              </property>
             </widget>
            </item>
            <item row="4" column="1">
             <widget class="QCheckBox" name="flagPlayerOnly">
              <property name="whatsThis">
               <string>If checked, NPCs will not use this weapon, and they won't pick it up if they see it lying around.</string>
              </property>
              <property name="text">
               <string>Player only</string>
              </property>
             </widget>
            </item>
            <item row="5" column="0">
             <widget class="QCheckBox" name="flagNonHostile">
              <property name="whatsThis">
               <string>If checked, an actor that is hit by this weapon will not consider that to be an aggressive act, and the weapon will not force combat.</string>
              </property>
              <property name="text">
               <string>Non-hostile</string>
              </property>
             </widget>
            </item>
            <item row="5" column="1">
             <widget class="QCheckBox" name="flagBound">
              <property name="whatsThis">
               <string>Controls whether this weapon can be used for a &quot;Bound Weapon&quot; Magic Effect.</string>
              </property>
              <property name="text">
               <string>Bound weapon</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox_2">
           <property name="title">
            <string>Critical Hits</string>
           </property>
           <layout class="QGridLayout" name="gridLayout_4">
            <item row="1" column="1">
             <widget class="QDoubleSpinBox" name="critDamage">
              <property name="whatsThis">
               <string>The amount of extra damage inflicted by critical hits with this weapon. This is a flat value added to the weapon's computed damage, and it's added after armor-related calculations, so it bypasses the target's armor.</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
              </property>
             </widget>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="label_19">
              <property name="text">
               <string>Spell to Apply:</string>
              </property>
              <property name="buddy">
               <cstring>critEffect</cstring>
              </property>
             </widget>
            </item>
            <item row="0" column="0">
             <widget class="QLabel" name="label_17">
              <property name="text">
               <string>Crit Chance Mult.:</string>
              </property>
              <property name="buddy">
               <cstring>critChanceMult</cstring>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QDoubleSpinBox" name="critChanceMult">
              <property name="whatsThis">
               <string>A multiplier which will be applied to the CritChance actor value for this weapon's wielder.</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
              </property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="DKFormPicker" name="critEffect">
