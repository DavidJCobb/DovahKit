     </item>
     <item row="3" column="1">
      <widget class="QSpinBox" name="enchantmentCharge">
       <property name="whatsThis">
        <string>If the weapon comes with a built-in enchantment, the enchantment's max and initial charge can be set here. For reference, a Grand Soul Gem provides 3000 charge.</string>
       </property>
       <property name="alignment">
        <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
       </property>
