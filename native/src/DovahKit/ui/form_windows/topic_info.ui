   <item row="1" column="2" rowspan="3">
    <layout class="QGridLayout" name="linkedTopicsLayout" columnstretch="0,0,0">
     <item row="0" column="2">
      <widget class="QCheckBox" name="flagInvisContinue">
       <property name="whatsThis">
        <string>If this option is checked, then you can only link this info to one topic. When an NPC finishes saying this info, the conversation will immediately move to that other topic without any dialogue options (e.g. the topic's text) being shown.</string>
       </property>
       <property name="text">
        <string>Invisible Continue</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0" colspan="3">
      <widget class="QTableView" name="linkedTopics">
       <property name="whatsThis">
        <string>&lt;p&gt;This is the list of topics that the conversation can move on to after an NPC finishes saying this info.&lt;/p&gt;
&lt;p&gt;Generally, each linked topic (that has at least one usable info) will be shown to the player as a dialogue option. There are two exceptions:&lt;/p&gt;
&lt;ul&gt;
   &lt;li&gt;&lt;p&gt;If &quot;Invisible Continue&quot; is enabled, then this info can only link to one topic. The conversation will move on to that topic's infos immediately after this info is said, without the player being given the opportunity to make a choice.&lt;/p&gt;&lt;/li&gt;
   &lt;li&gt;&lt;p&gt;One of these topics can be designated the &quot;Walk Away Topic,&quot; to be used if the player backs out of the dialogue menu in response to this info. You can choose to omit the Walk Away Topic from the list of dialogue options made available to the player.&lt;/p&gt;
&lt;/ul&gt;
&lt;p&gt;If there are no usable linked topics that can be shown to the player as dialogue options, then the NPC's top-level topic list will be shown instead.&lt;/p&gt;</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <spacer name="horizontalSpacer_2">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item row="0" column="0">
      <widget class="QLabel" name="label_6">
       <property name="text">
        <string>Link to Topics:</string>
       </property>
       <property name="buddy">
        <cstring>linkedTopics</cstring>
       </property>
      </widget>
     </item>
     <item row="2" column="0" colspan="3">
      <widget class="QGroupBox" name="walkAwayGroupbox">
       <property name="title">
        <string>Walk Away</string>
       </property>
       <property name="checkable">
        <bool>true</bool>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
       <layout class="QGridLayout" name="gridLayout_6">
        <item row="0" column="0">
         <widget class="QLabel" name="label_11">
          <property name="text">
           <string>Topic:</string>
          </property>
          <property name="buddy">
           <cstring>walkAwayTopic</cstring>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="DKFormPicker" name="walkAwayTopic">
          <property name="whatsThis">
           <string>&lt;p&gt;If the player backs out of this info's choice list, then the NPC will say a usable info (if any) from the Walk Away Topic as dialogue ends. The Walk Away Topic must be one of the topics that this info is linked to (in the list above).&lt;/p&gt;</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0" colspan="2">
         <widget class="QCheckBox" name="flagWalkAwayTopicInvis">
          <property name="whatsThis">
           <string>If this option is enabled, then the Walk Away Topic will not be shown in this info's choice list (that is, the player won't be able to select it as a dialogue option, and the topic will only be used if the player backs out of the dialogue menu).</string>
          </property>
          <property name="text">
           <string>Don't show this topic in the dialogue menu</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
