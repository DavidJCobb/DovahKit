     <item>
      <widget class="QLabel" name="label_9">
       <property name="text">
        <string>Conditions:</string>
       </property>
       <property name="buddy">
        <cstring>conditions</cstring>
       </property>
      </widget>
     </item>
     <item>
      <widget class="DKConditionList" name="conditions">
       <property name="whatsThis">
        <string>This info will only be considered usable if these conditions match. For the purposes of these conditions, the Subject is the actor who will say this info (if it's usable), and the Target is the actor to whom they will say it.</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item row="1" column="0" colspan="2">
    <layout class="QGridLayout" name="gridLayout_2" columnstretch="0,1,0,0,0">
     <item row="1" column="2">
      <widget class="QLabel" name="label_4">
       <property name="text">
        <string>Share Response Data from Info:</string>
       </property>
       <property name="buddy">
        <cstring>sharedInfo</cstring>
       </property>
      </widget>
     </item>
     <item row="1" column="3">
      <widget class="DKFormPicker" name="sharedInfo"/>
     </item>
     <item row="0" column="2" alignment="Qt::AlignRight">
      <widget class="QLabel" name="label_5">
       <property name="text">
        <string>Filter SharedInfo List:</string>
       </property>
       <property name="buddy">
        <cstring>sharedInfoSearch</cstring>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="label_3">
       <property name="text">
        <string>Responses:</string>
       </property>
       <property name="buddy">
        <cstring>responses</cstring>
       </property>
      </widget>
     </item>
     <item row="1" column="4">
      <widget class="QPushButton" name="buttonEditSharedInfo">
       <property name="text">
        <string>Edit...</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <spacer name="horizontalSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item row="2" column="0" colspan="5">
      <widget class="QTableView" name="responses">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="minimumSize">
        <size>
         <width>0</width>
         <height>75</height>
        </size>
       </property>
       <property name="maximumSize">
        <size>
         <width>16777215</width>
         <height>125</height>
        </size>
       </property>
       <property name="whatsThis">
        <string>&lt;p&gt;These are the lines of dialogue that the NPC says as part of this info. Each line is separated by a short delay (determined by the &lt;code&gt;fGameplayVoiceFilePadding&lt;/code&gt; game setting). Double-click a line to edit it, or right-click for more options.&lt;/p&gt;</string>
       </property>
      </widget>
     </item>
     <item row="0" column="3" colspan="2">
      <widget class="QLineEdit" name="sharedInfoSearch"/>
     </item>
    </layout>
   </item>
   <item row="2" column="0" colspan="2">
    <layout class="QGridLayout" name="gridLayout_3">
     <item row="0" column="0">
      <widget class="QCheckBox" name="flagHasLIPFile">
       <property name="text">
        <string>Has LIP File</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QCheckBox" name="flagForceSubtitles">
       <property name="whatsThis">
        <string>If checked, then the subtitle for this line will always be displayed, regardless of the player-character's distance from the speaker.</string>
       </property>
       <property name="text">
        <string>Force Subtitle</string>
       </property>
      </widget>
     </item>
     <item row="0" column="5">
      <layout class="QHBoxLayout" name="horizontalLayout">
       <item>
        <widget class="QLabel" name="label_7">
         <property name="text">
          <string>Favor Level:</string>
         </property>
         <property name="buddy">
          <cstring>favorLevel</cstring>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="favorLevel"/>
       </item>
      </layout>
     </item>
     <item row="1" column="2">
      <widget class="QCheckBox" name="flagRandomEnd">
       <property name="whatsThis">
        <string extracomment="Should be the same text as for the Random checkbox.">&lt;p&gt;This checkbox can be used to add randomized dialogue to a topic.&lt;/p&gt;
&lt;p&gt;Normally, the game checks a topic's infos one by one, and when it finds a usable info, it selects that info to be used if the player chooses the topic, and it stops checking. However, if the first matching info that the game finds is marked as Random, then the game will instead start building a list of usable infos. It'll keep checking through the topic and adding usable infos to the list until it finds an info that isn't marked as Random, or an info that's marked as Random End. Once it's done making the list, the game will pick one of those infos at random.&lt;/p&gt;</string>
       </property>
       <property name="text">
        <string>Random End</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QCheckBox" name="flagSayOnce">
       <property name="whatsThis">
        <string>&lt;p&gt;The intended behavior of this option is that if it's enabled, then each NPC can only say this info once. Once an NPC says this info, that NPC will never say it again, though any other NPC still can.&lt;/p&gt;
&lt;p&gt;In practice, this option only works properly if the info belongs to a quest that is Start Game Enabled. For all other quests, the game engine will forget what actors have said this info (thereby allowing them to say it again) once the player exits the game. If your quest can't be Start Game Enabled, then you should use conditional Papyrus properties or Globals to track whether this info has been said and prevent it from being said again.&lt;/p&gt;</string>
       </property>
       <property name="text">
        <string>Say Once</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QCheckBox" name="flagGoodbye">
       <property name="whatsThis">
        <string>If this is checked, then after an NPC finishes saying this info, they exit dialogue with the player.</string>
       </property>
       <property name="text">
        <string>Goodbye</string>
       </property>
      </widget>
     </item>
     <item row="1" column="3">
      <widget class="QCheckBox" name="flagReqPostprocess">
       <property name="whatsThis">
        <string>This flag has no effect in-game or in the Creation Kit, and exists solely to help with exporting dialogue for manipulation by other tools.</string>
       </property>
       <property name="text">
        <string>Requires post-processing</string>
       </property>
      </widget>
     </item>
     <item row="0" column="4">
      <widget class="QCheckBox" name="flagSpendsFavorPoints">
       <property name="whatsThis">
        <string>Unused.</string>
       </property>
       <property name="text">
        <string>Spends Favor Points</string>
       </property>
      </widget>
     </item>
     <item row="0" column="3">
      <widget class="QCheckBox" name="flagCanMoveWhileGreeting">
       <property name="whatsThis">
        <string>&lt;p&gt;If this info is a Hello (i.e. a line to be spoken to the player as they pass by, without entering the dialogue menu), then this checkbox controls whether the actor is allowed to continue moving while they say the line.&lt;/p&gt;
&lt;p&gt;To give some examples: you might leave this unchecked for lines where an NPC stops and greets the player, while leaving it checked for lines where an NPC mutters insults toward the player as they pass by.&lt;/p&gt;</string>
       </property>
       <property name="text">
        <string>Can Move While Greeting</string>
       </property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QCheckBox" name="flagRandom">
       <property name="whatsThis">
        <string>&lt;p&gt;This checkbox can be used to add randomized dialogue to a topic.&lt;/p&gt;
&lt;p&gt;Normally, the game checks a topic's infos one by one, and when it finds a usable info, it selects that info to be used if the player chooses the topic, and it stops checking. However, if the first matching info that the game finds is marked as Random, then the game will instead start building a list of usable infos. It'll keep checking through the topic and adding usable infos to the list until it finds an info that isn't marked as Random, or an info that's marked as Random End. Once it's done making the list, the game will pick one of those infos at random.&lt;/p&gt;</string>
       </property>
       <property name="text">
        <string>Random</string>
       </property>
      </widget>
     </item>
     <item row="1" column="5">
      <layout class="QHBoxLayout" name="horizontalLayout_2">
       <item>
        <widget class="QLabel" name="label_8">
         <property name="text">
          <string>Hours Until Reset:</string>
         </property>
         <property name="buddy">
          <cstring>hoursUntilReset</cstring>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QDoubleSpinBox" name="hoursUntilReset">
         <property name="whatsThis">
          <string>If this value is non-zero, then it represents a cooldown: once an actor says this info, that actor will not be able to say the info again until this many hours have passed.</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
         </property>
        </widget>
       </item>
      </layout>
     </item>
    </layout>
   </item>
