        <cstring>editorID</cstring>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="editorID"/>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QGridLayout" name="flagsAndLODLayout">
     <item row="3" column="0">
      <widget class="QCheckBox" name="flagHasHighDetailLODTexture">
       <property name="text">
        <string>High-Detail LOD Texture</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QCheckBox" name="flagObstacle">
       <property name="text">
        <string>Obstacle</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QCheckBox" name="flagHasLocalizedTextures">
       <property name="text">
        <string>Has Localized Textures</string>
       </property>
      </widget>
     </item>
     <item row="3" column="1" colspan="2">
      <widget class="QCheckBox" name="flagAddOnLODObject">
       <property name="text">
        <string>Add-On LOD Object</string>
       </property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QCheckBox" name="flagIsMarker">
       <property name="whatsThis">
        <string>If this is checked, then refs of this object will be invisible in-game, cannot be scaled, and can be used as enable state parents for other refs.</string>
       </property>
       <property name="text">
        <string>Is Marker</string>
       </property>
      </widget>
     </item>
     <item row="1" column="2">
      <widget class="QCheckBox" name="flagNeverFades">
       <property name="whatsThis">
        <string>If this option is checked, and a ref using this base form has the &quot;Is Full LOD&quot; option checked, then that ref won't fade out of view at a distance.</string>
       </property>
       <property name="text">
        <string>Never Fades</string>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QCheckBox" name="flagHasDistantLOD">
       <property name="whatsThis">
        <string>If this is checked, and if distant LOD meshes have been set for this object, then it will be visible outside of the loaded cell grid (i.e. uGridsToLoad).</string>
       </property>
       <property name="text">
        <string>Has Distant LOD</string>
       </property>
      </widget>
     </item>
     <item row="2" column="1" colspan="2">
      <widget class="QPushButton" name="buttonSpecifyLODMeshes">
       <property name="text">
        <string>Specify distant LOD meshes...</string>
       </property>
      </widget>
     </item>
     <item row="0" column="0">
      <widget class="QCheckBox" name="flagOnLocalMap">
       <property name="whatsThis">
        <string>If this is checked, the object will be visible on the player's Local Map.</string>
       </property>
       <property name="text">
        <string>On Local Map</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QCheckBox" name="flagHasTreeLOD">
       <property name="text">
        <string>Has Tree LOD</string>
       </property>
      </widget>
     </item>
     <item row="4" column="0" colspan="2">
      <widget class="QCheckBox" name="flagShowInWorldMap">
       <property name="text">
        <string>Show in World Map (must be in sky cell)</string>
       </property>
      </widget>
     </item>
     <item row="4" column="2">
      <widget class="QCheckBox" name="flagHasCurrents">
       <property name="text">
        <string>Has Currents</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
