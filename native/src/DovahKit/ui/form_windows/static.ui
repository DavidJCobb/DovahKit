      </item>
      <item row="0" column="1">
       <widget class="DKFormPicker" name="directionalMaterial"/>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="directionalMaterialIsSnow">
        <property name="text">
         <string>Is Snow</string>
        </property>
       </widget>
