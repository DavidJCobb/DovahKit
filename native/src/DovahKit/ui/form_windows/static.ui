   </item>
   <item>
    <widget class="QGroupBox" name="directionalMaterialGroupbox">
     <property name="whatsThis">
      <string>Apply a material effect (i.e. a texture) to the object, coating surfaces of the object that face a given direction. This can be useful for covering objects in snow, ashfall, and similar effects.</string>
     </property>
     <property name="title">
      <string>Directional material</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_2">
      <item row="1" column="0">
       <widget class="QLabel" name="label_3">
