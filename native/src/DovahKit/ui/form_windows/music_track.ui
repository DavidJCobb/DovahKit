     <item row="1" column="1">
      <widget class="QComboBox" name="trackType">
       <property name="whatsThis">
        <string>&lt;p&gt;Select the music track's type:&lt;/p&gt;
&lt;dl&gt;
   &lt;dt&gt;Palette Track&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;A multi-layer track type. Individual music tracks plugged into each layer will be played back at random, simultaneously with other layers.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;Silent Track&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;Used to create periods of silence in between traditional music tracks or in palettes. You can configure the duration in seconds.&lt;/p&gt;&lt;/dd&gt;
   &lt;dt&gt;Single Track&lt;/dt&gt;
      &lt;dd&gt;&lt;p&gt;A traditional music track.&lt;/p&gt;&lt;/dd&gt;
&lt;/dl&gt;
&lt;p&gt;Different track types offer different options in the tab view below.&lt;/p&gt;</string>
       </property>
       <item>
        <property name="text">
         <string>Palette Track</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Silent Track</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Single Track</string>
        </property>
       </item>
      </widget>
     </item>
