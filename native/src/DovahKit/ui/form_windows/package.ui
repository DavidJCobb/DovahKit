            </item>
            <item row="0" column="5">
             <widget class="QDoubleSpinBox" name="idlesTimer">
              <property name="whatsThis">
               <string>If this marker plays animations in a random order, then this is the duration of each animation. If this marker plays all of its animations in sequence, then this is the delay between each time the sequence loops.</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
              </property>
             </widget>
            </item>
