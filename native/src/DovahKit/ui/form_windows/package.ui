               <property name="whatsThis">
                <string>&lt;p&gt;Packages can define package data: forms and basic values to be fed into their procedures. Using this checkbox, a package template can decide whether a piece of package data is meant for internal use only, or whether it can be overridden by packages based on the template.&lt;/p&gt;
&lt;p&gt;This checkbox won't appear when editing a package that isn't a template.&lt;/p&gt;</string>
               </property>
               <property name="text">
                <string>Allow packages based on this template to override this value</string>
               </property>
              </widget>
