       <item row="1" column="0" colspan="2">
        <widget class="QGroupBox" name="groupBox_7">
         <property name="whatsThis">
          <string>&lt;p&gt;If this package uses a template, then that template can allow you to specify data inputs. The list of available inputs will be shown in the lefthand pane; select one and then use the controls to the right to change what data is fed into the input.&lt;/p&gt;
&lt;p&gt;If this package &lt;em&gt;is&lt;/em&gt; a template, then this is where you can define the inputs that are exposed to any packages that use this template. You can also set those inputs' default values.&lt;/p&gt;</string>
         </property>
         <property name="title">
          <string>Public Package Data</string>
         </property>
         <layout class="QHBoxLayout" name="horizontalLayout_2">
          <item>
