       <property name="text">
        <string>Editor ID:</string>
       </property>
       <property name="buddy">
        <cstring>editorID</cstring>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="DKFormPicker" name="owningQuest">
       <property name="whatsThis">
        <string>If a package has an owning quest, then that quest's aliases can be used as inputs for package data.</string>
       </property>
      </widget>
     </item>
     <item row="1" column="2">
      <widget class="QLabel" name="label_4">
