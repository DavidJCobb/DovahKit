     <widget class="QWidget" name="tabStartup">
      <attribute name="title">
       <string>Schedule and Conditions</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_5">
       <item row="2" column="0">
        <spacer name="verticalSpacer_3">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>343</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="0" column="0">
        <widget class="QGroupBox" name="groupBox_6">
         <property name="whatsThis">
          <string>&lt;p&gt;Control when this package activates. You can have the package activate on specific weekdays, calendar dates, times of day, et cetera, or leave those options set to &quot;any.&quot; You can only have the package activate at a specific minute if you also have it activate at a specific hour (i.e. you can have a package run at 5:30 AM, but you can't have a package run at &quot;half-past every hour&quot;).&lt;/p&gt;
&lt;p&gt;These options are not available for package templates.&lt;/p&gt;</string>
         </property>
         <property name="title">
          <string>Schedule</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_6">
          <item row="0" column="0">
           <widget class="QLabel" name="label_5">
            <property name="text">
             <string>Weekday:</string>
            </property>
            <property name="buddy">
             <cstring>scheduleWeekday</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_6">
            <property name="text">
             <string>Month:</string>
            </property>
            <property name="buddy">
             <cstring>scheduleMonth</cstring>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_7">
            <property name="text">
             <string>Date:</string>
            </property>
            <property name="buddy">
             <cstring>scheduleDate</cstring>
            </property>
           </widget>
