        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="damage">
        <property name="whatsThis">
         <string>The amount of damage that refs within the blast radius may receive.</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
      <item row="8" column="1">
       <widget class="QComboBox" name="detectionSoundLevel">
        <property name="whatsThis">
