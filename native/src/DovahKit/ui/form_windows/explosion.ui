      <item row="10" column="1">
       <widget class="DKFormPicker" name="chainProjectile">
        <property name="whatsThis">
         <string>This option is used for Chain Lightning and similar spells. If enabled, you can select a projectile to spawn for each &quot;bounce.&quot; The projectile you select here must be of the same type (beam, missile, etc.) as the projectile that originally spawned the explosion.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QCheckBox" name="flagPushSourceOnly">
        <property name="whatsThis">
         <string>&lt;p&gt;If checked, the explosion will only physically displace the object that spawned it.&lt;/p&gt;
&lt;p&gt;This can be used to make destructible objects break apart with more flair: you can make an object blast apart slightly when destroyed, without influencing the objects around it, by setting its destruction stages to use an explosion with this box checked.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Push Source Ref Only</string>
        </property>
       </widget>
      </item>
      <item row="8" column="0">
       <widget class="QLabel" name="label_5">
        <property name="text">
         <string>Detection Sound Level:</string>
        </property>
        <property name="buddy">
         <cstring>detectionSoundLevel</cstring>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QDoubleSpinBox" name="radius">
        <property name="whatsThis">
         <string>The radius of the explosion's effect: any rigid body within this radius is pushed, and any ref within it may be damaged.</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
