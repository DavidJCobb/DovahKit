   <string>Magic Effect</string>
  </property>
  <layout class="QGridLayout" name="gridLayout_6" rowstretch="0,1,0" columnstretch="1,1,1">
   <item row="0" column="0" rowspan="2">
    <layout class="QVBoxLayout" name="leftCol">
     <item>
