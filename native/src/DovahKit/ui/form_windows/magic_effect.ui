         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="label_40">
          <property name="text">
           <string>Ready:</string>
          </property>
          <property name="buddy">
           <cstring>soundReady</cstring>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="label_39">
          <property name="text">
           <string>Charge:</string>
          </property>
          <property name="buddy">
           <cstring>soundCharge</cstring>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="DKFormPicker" name="soundDrawSheathe">
          <property name="whatsThis">
           <string>The sound that plays when the player draws or sheathes their weapons with this spell in either hand.</string>
          </property>
         </widget>
        </item>
        <item row="5" column="0">
         <widget class="QLabel" name="label_43">
          <property name="text">
           <string>On Hit:</string>
          </property>
          <property name="buddy">
           <cstring>soundOnHit</cstring>
          </property>
         </widget>
        </item>
        <item row="0" column="0">
         <widget class="QLabel" name="label_38">
          <property name="text">
           <string>Draw/Sheathe:</string>
          </property>
          <property name="buddy">
           <cstring>soundDrawSheathe</cstring>
          </property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="label_42">
          <property name="text">
           <string>Cast Loop (Conc.):</string>
          </property>
          <property name="buddy">
           <cstring>soundCastLoop</cstring>
          </property>
         </widget>
        </item>
        <item row="6" column="0">
