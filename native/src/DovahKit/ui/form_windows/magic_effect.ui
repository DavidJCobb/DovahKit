       <layout class="QGridLayout" name="gridLayout_11">
        <item row="3" column="0">
         <widget class="QLabel" name="label_41">
          <property name="text">
           <string>Release:</string>
          </property>
          <property name="buddy">
           <cstring>soundRelease</cstring>
