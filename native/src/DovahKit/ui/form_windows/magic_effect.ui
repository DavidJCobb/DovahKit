     <item>
      <layout class="QGridLayout" name="gridLayout_5">
       <item row="0" column="0">
        <widget class="QLabel" name="label_19">
         <property name="text">
          <string>Equip Ability:</string>
         </property>
         <property name="buddy">
          <cstring>equipAbility</cstring>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="DKFormPicker" name="equipAbility">
         <property name="whatsThis">
          <string>A spell to apply to the caster when they equip this effect. These are not chainable: a spell that is added via an equip ability will not then add the equip abilities of its own effects.</string>
         </property>
        </widget>
       </item>
      </layout>
