        <item row="4" column="1">
         <widget class="DKFormPicker" name="enchantArt">
          <property name="whatsThis">
           <string>For enchantments only, this is the art object attached to the enchanted item.</string>
          </property>
         </widget>
        </item>
        <item row="5" column="1">
         <widget class="DKFormPicker" name="enchantShader">
          <property name="whatsThis">
           <string>For enchantments only, this is the EffectShader applied to the enchanted item.</string>
          </property>
         </widget>
        </item>
        <item row="6" column="1">
         <widget class="DKFormPicker" name="projectile">
