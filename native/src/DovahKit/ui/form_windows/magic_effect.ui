          </property>
         </widget>
        </item>
        <item row="7" column="1">
         <widget class="DKFormPicker" name="impactDataSet">
          <property name="whatsThis">
           <string>When the projectile hits an object, the impact data set is used to determine which decals, if any, are applied.</string>
          </property>
