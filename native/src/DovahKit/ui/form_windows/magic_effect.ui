     <item>
      <widget class="QGroupBox" name="groupBox_6">
       <property name="title">
        <string>Spellmaking</string>
       </property>
       <layout class="QGridLayout" name="gridLayout_9">
        <item row="0" column="0">
         <widget class="QLabel" name="label_27">
          <property name="text">
           <string>Power Affects:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="label_28">
          <property name="text">
           <string>Area:</string>
          </property>
          <property name="buddy">
           <cstring>spellmakingArea</cstring>
          </property>
         </widget>
        </item>
        <item row="1" column="2">
         <widget class="QLabel" name="label_29">
          <property name="text">
           <string>Casting Time:</string>
          </property>
          <property name="buddy">
           <cstring>spellmakingCastingTime</cstring>
          </property>
         </widget>
        </item>
        <item row="1" column="3">
         <widget class="QDoubleSpinBox" name="spellmakingCastingTime">
          <property name="whatsThis">
           <string>&lt;p&gt;The number of seconds the casting button needs to be held down before the spell can be cast. Usually 0.5 seconds.&lt;/p&gt;
&lt;p&gt;For two-handed spells with lengthy cast times, it's recommended to use the RitualSpellEffect keyword. Character animations are defined to check for that keyword and use a more appropriate animation.&lt;/p&gt;</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
          </property>
         </widget>
        </item>
        <item row="0" column="1" colspan="3">
         <layout class="QHBoxLayout" name="horizontalLayout">
          <item>
           <widget class="QCheckBox" name="flagPowerAffectsMagnitude">
            <property name="whatsThis">
             <string>If checked, the effect's magnitude will be scaled when dual-casting, or by the player's Alchemy and Enchanting skill and perks when making potions and enchantments containing the effect.</string>
            </property>
            <property name="text">
             <string>Magnitude</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="flagPowerAffectsDuration">
            <property name="whatsThis">
             <string>If checked, the effect's duration will be scaled when dual-casting, or by the player's Alchemy and Enchanting skill and perks when making potions and enchantments containing the effect.</string>
            </property>
            <property name="text">
             <string>Duration</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item row="1" column="1">
         <widget class="QSpinBox" name="spellmakingArea">
          <property name="whatsThis">
           <string>The effect's radius. Unusually, this is measured in feet, not world units. One foot is 21⅓ world units.</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
          </property>
          <property name="maximum">
           <number>4096</number>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupBox_7">
