           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QDoubleSpinBox" name="injuredHealthPercentage">
           <property name="whatsThis">
            <string>If an actor of this race has their health drop below this percentage, the game will set the &quot;Injured&quot; boolean variable in their behavior graph to &quot;true.&quot; This can be used to alter the actor's animations. Additionally, the GetIsInjured condition checks that variable.</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
           </property>
           <property name="decimals">
            <number>4</number>
