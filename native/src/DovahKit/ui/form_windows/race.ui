          <item row="4" column="0">
           <widget class="QCheckBox" name="flagAvoidsRoads">
            <property name="text">
             <string>Avoids Roads</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QCheckBox" name="flagFlies">
            <property name="whatsThis">
             <string>Indicates that actors of this race can fly, animations permitting.</string>
            </property>
            <property name="text">
             <string>Flies</string>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QCheckBox" name="flagNotPushable">
            <property name="whatsThis">
             <string>If checked, objects and the player can't shove actors of this race.</string>
            </property>
            <property name="text">
             <string>Not Pushable</string>
            </property>
           </widget>
          </item>
          <item row="8" column="0">
           <widget class="QCheckBox" name="flagUsesHeadtrackAnims">
            <property name="text">
             <string>Uses Headtracking Animations</string>
            </property>
           </widget>
          </item>
          <item row="0" column="0">
           <widget class="QCheckBox" name="flagImmobile">
            <property name="text">
             <string>Immobile</string>
            </property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QCheckBox" name="flagNoWaterCombat">
            <property name="whatsThis">
             <string>Control whether actors of this race can attack or cast spells while swimming.</string>
            </property>
            <property name="text">
             <string>No Combat in Water</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QCheckBox" name="flagTiltRoll">
            <property name="whatsThis">
             <string>&lt;p&gt;This checkbox controls whether actors of this race are allowed to tilt sideways (i.e. whether they're allowed to rotate about their local Y-axis). If not, the game will ensure that their Y-axis rotation is always zero.&lt;/p&gt;
&lt;p&gt;This is generally left unchecked for bipeds and quadrupeds, to keep them upright, while being checked for insectoid races, like spiders and chauruses.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Tilt Left/Right</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QCheckBox" name="flagSwims">
            <property name="whatsThis">
             <string>Indicates whether actors of this race can swim. If a race &lt;em&gt;only&lt;/em&gt; has Swims checked, then actors of that race can't leave the water. If a race &lt;em&gt;doesn't&lt;/em&gt; have Swims checked, then actors of that race can't swim, but may be able to pass over areas of deep water without swimming (e.g. by using Waterwalking).</string>
            </property>
            <property name="text">
             <string>Swims</string>
            </property>
           </widget>
          </item>
          <item row="7" column="0">
           <widget class="QCheckBox" name="flagNoRotateToHeadtrack">
            <property name="text">
             <string>No Rotating to Headtrack</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QCheckBox" name="flagTiltPitch">
            <property name="whatsThis">
             <string>&lt;p&gt;This checkbox controls whether actors of this race are allowed to pitch forward and backward (i.e. whether they're allowed to rotate about their local X-axis). If not, the game will ensure that their X-axis rotation is always zero.&lt;/p&gt;
&lt;p&gt;This is generally left unchecked for bipeds, to keep them upright, while being checked for quadrupeds and insectoid races, like horses, spiders, and chauruses.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Tilt Front/Back</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
