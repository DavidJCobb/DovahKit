         <property name="title">
          <string>Flags</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_10">
          <item row="2" column="0">
           <widget class="QCheckBox" name="flagAllowPickpocket">
            <property name="whatsThis">
             <string>If this is checked, then the player can pickpocket actors of this race.</string>
            </property>
            <property name="text">
             <string>Can Be Pickpocketed</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QCheckBox" name="flagChild">
            <property name="whatsThis">
             <string>Races that are flagged as &quot;Child&quot; races will have hardcoded behaviors suitable for child characters, such as limitations on what activators they can use (for the sake of age-appropriate animations) and an inability to die (for the sake of the developers' restraint in storytelling).</string>
            </property>
            <property name="text">
             <string>Child</string>
            </property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="QCheckBox" name="flagAllowPlayerDialogue">
            <property name="whatsThis">
             <string>Control whether the player is allowed to talk to actors of this race.</string>
            </property>
            <property name="text">
             <string>Allow Player Dialogue</string>
            </property>
           </widget>
          </item>
          <item row="2" column="3">
           <widget class="QCheckBox" name="flagMultipleMembraneShaders">
            <property name="text">
             <string>Allow Multiple Membrane Shaders</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QCheckBox" name="flagPlayable">
            <property name="whatsThis">
             <string>Control whether the player is allowed to use this race in character creation.</string>
            </property>
            <property name="text">
             <string>Playable</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QCheckBox" name="flagCannotOpenDoors">
            <property name="whatsThis">
             <string>If this is checked, then actors of this race cannot open doors. This is generally appropriate for wildlife and monster races.</string>
            </property>
            <property name="text">
             <string>Can't Open Doors</string>
            </property>
           </widget>
          </item>
          <item row="2" column="2">
           <widget class="QCheckBox" name="flagAllowRagdollCollision">
            <property name="text">
             <string>Allow Ragdoll Collision</string>
            </property>
           </widget>
          </item>
          <item row="1" column="3">
           <widget class="QCheckBox" name="flagFaceGenHead">
            <property name="text">
             <string>FaceGen Head</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QCheckBox" name="flagNoKnockdowns">
            <property name="whatsThis">
             <string>If this is checked, then actors of this race cannot be knocked down and put into a ragdoll state.</string>
            </property>
            <property name="text">
             <string>Can't Be Knocked Down</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QCheckBox" name="flagNoShadow">
            <property name="whatsThis">
             <string>If this is checked, then actors of this race do not cast shadows.</string>
            </property>
            <property name="text">
             <string>Never Casts Shadows</string>
            </property>
           </widget>
          </item>
          <item row="3" column="2">
           <widget class="QCheckBox" name="flagSpellsAlignWithMagicNode">
            <property name="text">
             <string>Spells Align with Magic Node</string>
            </property>
           </widget>
          </item>
          <item row="3" column="3">
           <widget class="QCheckBox" name="flagCanPickUpItems">
            <property name="whatsThis">
             <string>Control whether actors of this race are able to pick up items. Actors may want to pick up items for a variety of reasons, including if they see a nearby weapon that may be useful when retaliating against a strong attacker.</string>
            </property>
            <property name="text">
             <string>Can Pick Up Items</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
