              </property>
             </spacer>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="label_80">
              <property name="text">
               <string>Head Slot:</string>
              </property>
              <property name="buddy">
               <cstring>bipedSlotHead</cstring>
              </property>
             </widget>
