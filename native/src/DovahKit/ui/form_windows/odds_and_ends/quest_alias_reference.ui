          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QComboBox" name="additionalVoicetypes">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use this to provide DovahKit and the Creation Kit with some guidance when editing dialogue: if the options on the &amp;quot;Fill&amp;quot; tab don't give the editor enough information to determine what Voicetypes are valid for this alias, you can specify an ActorBase or a FormList of Voicetypes here.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
         <item row="0" column="5">
          <widget class="QComboBox" name="displayName">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A Message form whose &amp;quot;title&amp;quot; will replace the name of any ObjectReference that this alias is filled with. The &amp;quot;Clears Name When Removed&amp;quot; checkbox controls whether the name change is permanent.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_2">
           <property name="text">
            <string>Force Into Alias When Filled</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
           </property>
           <property name="buddy">
            <cstring>forceInto</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="0" colspan="2">
          <layout class="QHBoxLayout" name="horizontalLayout">
           <item>
            <widget class="QLabel" name="label">
             <property name="text">
              <string>Name:</string>
             </property>
