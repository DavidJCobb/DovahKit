          <widget class="QRadioButton" name="findMatchingModeLoadedArea">
           <property name="whatsThis">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The matching reference will be selected from the loaded area. If you use this option, you must specify at least one condition.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>...In Loaded Area</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item row="8" column="1">
        <widget class="QCheckBox" name="findMatchingFlagClosest">
         <property name="whatsThis">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If unchecked, the alias will be filled with an ObjectReference chosen randomly from all ObjectReferences in the loaded area that match the given conditions. If checked, the alias will be filled with the matching ObjectReference that is closest to the player-character.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Closest</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
