     </item>
     <item row="1" column="3">
      <widget class="QCheckBox" name="flagIgnoredBySandbox">
       <property name="whatsThis">
        <string>If checked, actors will never find this idle marker when wandering as part of a Sandbox Package; they must be specifically directed to use it.</string>
       </property>
       <property name="text">
