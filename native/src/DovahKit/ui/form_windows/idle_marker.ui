  <layout class="QVBoxLayout" name="verticalLayout_2">
   <item>
    <layout class="QGridLayout" name="gridLayout">
     <item row="0" column="3">
      <widget class="QCheckBox" name="flagChild">
       <property name="whatsThis">
        <string>If checked, children won't be blocked from using this idle marker (though if they lack the appropriate animations, they won't use it anyway).</string>
       </property>
       <property name="text">
        <string>Child Can Use</string>
       </property>
