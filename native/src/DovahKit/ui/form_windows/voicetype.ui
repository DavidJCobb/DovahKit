   <item row="2" column="0" colspan="2">
    <widget class="QCheckBox" name="allowDefault">
     <property name="whatsThis">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If this option is enabled, then this voicetype will be valid for any dialogue whose conditions don't explicitly exclude actors with this voicetype. &amp;quot;Valid&amp;quot; here means that the game will check for and use sound files associated with this voicetype when the dialogue in question plays. You would typically enable this option for voices that are meant to apply to &amp;quot;generic&amp;quot; dialogue, while disabling it for creatures, unique NPC voices, and so on.&lt;/p&gt;&lt;p&gt;If this option is disabled, then this voicetype will only be valid for lines of dialogue that include the voicetype (directly or indirectly) by virtue of having one of the following conditions:&lt;/p&gt;&lt;p&gt;GetAllowWorldInteractions&lt;br/&gt;GetFactionRank&lt;br/&gt;GetInFaction&lt;br/&gt;GetIsAliasRef&lt;br/&gt;GetIsCreature&lt;br/&gt;GetIsCreatureType&lt;br/&gt;GetIsClass&lt;br/&gt;GetIsFormType&lt;br/&gt;GetIsID&lt;br/&gt;GetIsPlayableRace&lt;br/&gt;GetIsRace&lt;br/&gt;GetIsReference&lt;br/&gt;GetIsSex&lt;br/&gt;GetIsVoiceType&lt;br/&gt;IsChild&lt;br/&gt;IsInList&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="text">
      <string>Allow default dialogue</string>
     </property>
    </widget>
   </item>
  </layout>
