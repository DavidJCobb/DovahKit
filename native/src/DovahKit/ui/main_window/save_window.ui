      <widget class="QComboBox" name="compressionPolicy">
       <item>
        <property name="text">
         <string>None</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Use Threshold</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Mimic Skyrim.esm</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="5" column="0">
      <widget class="QLabel" name="label_4">
       <property name="text">
        <string>Compression Threshold</string>
       </property>
      </widget>
     </item>
