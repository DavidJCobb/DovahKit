<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010"> 
   <Type Name="dovah::datastores::impl::idles::idle_node">
      <Intrinsic Name="_parent_as_loose" Expression="dynamic_cast&lt;loose_idle_list_node*&gt;(canonical_parent)" />
      
      <DisplayString>IDLE:{stub.editorID,sb}</DisplayString>
      <Expand>
         <Item Name="[stub]">stub,na</Item>
         <Item Name="[is loose idle in]" Condition="_parent_as_loose() &amp;&amp; _parent_as_loose()-&gt;graph">_parent_as_loose()-&gt;graph,na</Item>
         <Item Name="[canonical parent]">canonical_parent,na</Item>
         <Item Name="[children]">child_idles,na</Item>
         <Item Name="[first seen ANAM]">first_seen_anam</Item>
         <Item Name="[action root candidacies]">is_candidate_for</Item>
         <Item Name="[sort state during build]">_sort_state</Item>
      </Expand>
   </Type>
   <Type Name="dovah::datastores::impl::idles::idle_node::candidacy">
      <DisplayString>{action,na}</DisplayString>
      <Expand>
         <Item Name="action">action,na</Item>
         <ExpandedItem>(dovah::utils::subrecord_data_position*)this</ExpandedItem>
      </Expand>
   </Type>
</AutoVisualizer>