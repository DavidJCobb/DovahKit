<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010"> 
   <Type Name="dovah::datastores::impl::idles::action_node">
      <DisplayString>[action:{stub.editorID,sb}]</DisplayString>
      <Expand>
         <Item Name="[stub]">stub</Item>
         <Item Name="[root idle]" Condition="children.size() == 0">(idle_node*)nullptr</Item>
         <Item Name="[root idle]" Condition="children.size() == 1">children[0],na</Item>
         <Item Name="[root idles]" Condition="children.size() &gt; 1">children,na</Item>
      </Expand>
   </Type>
</AutoVisualizer>