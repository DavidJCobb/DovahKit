            <Expand>
               <Item Name="[success completes package]">flags &amp; 1 != 0</Item>
               <Item Name="[raw]">flags</Item>
            </Expand>
         </Synthetic>
         <Item Name="[flag overrides]">flag_overrides</Item>
         <Item Name="[parameters]">parameter_unique_ids</Item>
      </Expand>
   </Type>
</AutoVisualizer>