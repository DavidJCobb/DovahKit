<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
   <Type Name="vulkanDK::rendered_landscape">

      <Intrinsic Name="_dg" Expression="((v == 100 ? 99 : v) / (d == 0 ? 1 : (d == 1 ? 10 : (d == 2 ? 100 : 0)))) % 10">
         <Parameter Name="v" Type="int" />
         <Parameter Name="d" Type="int" />
      </Intrinsic>
      
      <Intrinsic Name="_bl0" Expression="(int)(vertices[r*34+v].blends[0]*100)">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl1" Expression="(int)(vertices[r*34+v].blends[1]*100)">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl2" Expression="(int)(vertices[r*34+v].blends[2]*100)">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl3" Expression="(int)(vertices[r*34+v].blends[3]*100)">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl4" Expression="(int)(vertices[r*34+v].blends[4]*100)">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl5" Expression="(int)(vertices[r*34+v].blends[5]*100)">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>

      <Intrinsic Name="_bld_impl" Expression="100 - (_bl0(r,v)+_bl1(r,v)+_bl2(r,v)+_bl3(r,v)+_bl4(r,v)+_bl5(r,v))">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bld" Expression="_bld_impl(r, v) &lt; 0 ? 0 : _bld_impl(r, v)">
         <Parameter Name="r" Type="int" />
         <Parameter Name="v" Type="int" />
      </Intrinsic>
      
      <DisplayString>{{ {lifetime.life_state,en}; frames={lifetime.sync_state}; position={{ {(int)frame_drawing_data.position.x,d}, {(int)frame_drawing_data.position.y,d} }}; grid pos={{ {(int)frame_drawing_data.position.x/4096,d}, {(int)frame_drawing_data.position.y/4096,d} }} }}</DisplayString>
      <Expand>
         <Item Name="vertices">vertices</Item>
         <Item Name="frame_drawing_data">frame_drawing_data</Item>
         
         <!--
         
         Javascript to generate the blend natvis tags:
         
(function() {
   let out = "";
   
   const indent = "               ";
   
   // Base texture opacity i.e. where nothing is blended
   {
      out += `${indent}<Synthetic Name="[base tex]">` + "\n" + `${indent}   <DisplayString>Opacity of the base texture: 100% minus the sum of all blends.</DisplayString>` + "\n" + `${indent}   <Expand>` + "\n";
      for(let r = 0; r < 34; ++r) {
         out += "                     ";
         if (r == 17) {
            out += `<Synthetic Name="===="><DisplayString>======================================================================================================</DisplayString></Synthetic>\n`;
            continue;
         }
         out += `<Synthetic Name="Y=${r}"><DisplayString>`;
         for(let x = 0; x < 34; ++x) {
            if (x == 17) {
               out += " |  ";
               continue;
            }
            let sr = (34 - r - 1);

            for(let d = 1; d >= 0; d -= 1) {
               out += `{_dg(_bld(${r},${x}),${d}),d}`;
            }
            if (x != 33)
               out += ` `;
         }
         out += `</DisplayString></Synthetic>\n`;
      }
      out += `${indent}   </Expand>` + "\n" + `${indent}</Synthetic>` + "\n";
   }
   
   for(let b = 0; b < 6; ++b) {
      out += `${indent}<Synthetic Name="[blend ${b}]">` + "\n";
      if (b == 0) {
         out += `${indent}   <DisplayString>Opacities capped to 99 for text alignment purposes.</DisplayString>` + "\n";
      }
      out += `${indent}   <Expand>` + "\n";

      for(let r = 0; r < 34; ++r) {
         out += "                     ";
         if (r == 17) {
            out += `<Synthetic Name="===="><DisplayString>======================================================================================================</DisplayString></Synthetic>\n`;
            continue;
         }
         out += `<Synthetic Name="Y=${r}"><DisplayString>`;
         for(let x = 0; x < 34; ++x) {
            if (x == 17) {
               out += " |  ";
               continue;
            }
            let sr = (34 - r - 1);

            for(let d = 1; d >= 0; d -= 1) {
               out += `{_dg(_bl${b}(${r},${x}),${d}),d}`;
            }
            if (x != 33)
               out += ` `;
         }
         out += `</DisplayString></Synthetic>\n`;
      }

      out += `${indent}   </Expand>` + "\n" + `${indent}</Synthetic>` + "\n";

   }

   return out;
})();
         
