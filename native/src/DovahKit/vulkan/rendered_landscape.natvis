<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
   <Type Name="vulkanDK::rendered_landscape">

      <!--
         Helper: extract a single digit from a number; use to display a number
         padded to a desired digit count. 
         
         Example: {_dg(5, 1),d}{_dg(5, 0),d} produces "05"
      -->
      <Intrinsic Name="_dg" Expression="((v == 100 ? 99 : v) / (d == 0 ? 1 : (d == 1 ? 10 : (d == 2 ? 100 : 0)))) % 10">
         <Parameter Name="v" Type="int" />
         <Parameter Name="d" Type="int" />
      </Intrinsic>
      
      <Intrinsic Name="_bl0" Expression="(int)(vertices[i].blends[0]*100)">
         <Parameter Name="i" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl1" Expression="(int)(vertices[i].blends[1]*100)">
         <Parameter Name="i" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl2" Expression="(int)(vertices[i].blends[2]*100)">
         <Parameter Name="i" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl3" Expression="(int)(vertices[i].blends[3]*100)">
         <Parameter Name="i" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl4" Expression="(int)(vertices[i].blends[4]*100)">
         <Parameter Name="i" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bl5" Expression="(int)(vertices[i].blends[5]*100)">
         <Parameter Name="i" Type="int" />
      </Intrinsic>

      <!-- Get the opacity of the base texture, i.e. 100% minus sum of all blended textures' opacities. -->
      <Intrinsic Name="_bld_impl" Expression="100 - (_bl0(i)+_bl1(i)+_bl2(i)+_bl3(i)+_bl4(i)+_bl5(i))">
         <Parameter Name="i" Type="int" />
      </Intrinsic>
      <Intrinsic Name="_bld" Expression="_bld_impl(i) &lt; 0 ? 0 : _bld_impl(i)">
         <Parameter Name="i" Type="int" />
      </Intrinsic>
      
      <DisplayString>{{ {lifetime.life_state,en}; frames={lifetime.sync_state}; position={{ {(int)frame_drawing_data.position.x,d}, {(int)frame_drawing_data.position.y,d} }}; grid pos={{ {(int)frame_drawing_data.position.x/4096,d}, {(int)frame_drawing_data.position.y/4096,d} }} }}</DisplayString>
      <Expand>
         <Item Name="vertices">vertices</Item>
         <Item Name="frame_drawing_data">frame_drawing_data</Item>
         
         <!--
         
         Javascript to generate the blend natvis tags:
         
(function() {
   let out = "";
   
   const indent = "               ";
   
   function _generate_grid(indent, lookup_func_name) {
      let out = `${indent}<Expand>` + "\n";
      for(let y = 0; y < 34; ++y) {
         if (y == 17) {
            out += `${indent}   <Synthetic Name=" "><DisplayString>`;
            for(let x = 0; x < 34; ++x) {
               if (x == 17) {
                  out += "-|-" + "-"; // We're putting this code in an XML comment, so no double-dashes
               }
               out += "-" + "-"; // We're putting this code in an XML comment, so no double-dashes
               if (x != 33)
                  out += `-`;
            }
            out += `</DisplayString></Synthetic>` + "\n";
         }
         out += `${indent}   <Synthetic Name="Y=${y}"><DisplayString>`;
         for(let x = 0; x < 34; ++x) {
            if (x == 17) {
               out += " |  ";
            }
            
            let quad = (x > 16 ? 1 : 0) + (y > 16 ? 2 : 0);
            
            let i = (quad * (17 * 17));
            i += (y % 17) * 17;
            i += (x % 17);
            
            for(let d = 1; d >= 0; d -= 1) {
               out += `{_dg(${lookup_func_name}(${i}),${d}),d}`;
            }
            if (x != 33)
               out += ` `;
         }
         out += `</DisplayString></Synthetic>` + "\n";
      }
      out += `${indent}</Expand>` + "\n";
      return out;
   }
   
   // Base texture opacity i.e. where nothing is blended
   {
      out += `${indent}<Synthetic Name="[base tex]">` + "\n";
      out += `${indent}   <DisplayString>Opacity of the base texture: 100% minus the sum of all blends.</DisplayString>` + "\n";
      out += _generate_grid(indent + "   ", "_bld");
      out += `${indent}</Synthetic>` + "\n";
   }
   
   for(let b = 0; b < 6; ++b) {
      out += `${indent}<Synthetic Name="[blend ${b}]">` + "\n";
      if (b == 0) {
         out += `${indent}   <DisplayString>Opacities capped to 99 for text alignment purposes.</DisplayString>` + "\n";
      }
      out += _generate_grid(indent + "   ", `_bl${b}`);
      out += `${indent}</Synthetic>` + "\n";
   }

   return out;
})();
         
